@model ProfilePageVm
@{ViewData["Title"]="Hồ sơ cá nhân";var role=Model.Account.Role=="Provider"?"Nhà cung cấp":Model.Account.Role=="Admin"?"Quản trị viên":"Khách du lịch";}
<section class="workspace section"><div class="page-heading"><div><span class="eyebrow">TÀI KHOẢN CỦA BẠN</span><h1>Hồ sơ cá nhân</h1><p class="muted">Thông tin được sửa và thông tin chỉ xem được phân biệt rõ bên dưới.</p></div><span class="badge-status">@role</span></div><div asp-validation-summary="All" class="validation-error" role="alert"></div><div class="cards"><form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="panel"><h2>Thông tin của bạn</h2><input asp-for="Input.Version" type="hidden"/><input asp-for="Input.ProviderVersion" type="hidden"/><p class="muted">Email đăng nhập (chỉ xem): <strong>@Model.Account.Email</strong><br/>Vai trò (chỉ xem): <strong>@role</strong></p>@if(Model.Profile.AvatarDocumentId is int avatar){<img src="/Verification/Avatar/@avatar" alt="Ảnh đại diện của bạn" width="90" height="90" style="border-radius:50%;object-fit:cover;margin-bottom:20px"/>}<label>Ảnh đại diện JPG/PNG tối đa 5 MB<input asp-for="Input.Avatar" type="file" accept=".jpg,.jpeg,.png"/></label><label>Tên hiển thị<input asp-for="Input.Name" required minlength="2" maxlength="100"/><span asp-validation-for="Input.Name"></span></label><label>Số điện thoại<input asp-for="Input.Phone" type="tel" maxlength="30"/><span asp-validation-for="Input.Phone"></span></label><label>Giới thiệu<textarea asp-for="Input.Bio" maxlength="1000"></textarea></label><label>Nơi sinh sống<input asp-for="Input.Residence" maxlength="200"/></label><label>Sở thích<input asp-for="Input.Interests" maxlength="500" placeholder="Trekking, cà phê, nhiếp ảnh…"/></label><label>Phạm vi chia sẻ hồ sơ<select asp-for="Input.SharingScope"><option value="Private">Chỉ mình tôi</option><option value="Connected">Người đã kết nối</option><option value="Registered">Thành viên đã đăng nhập</option><option value="Public">Công khai</option></select></label><label class="check-label"><input asp-for="Input.ShareContact"/>Cho phép chia sẻ liên hệ theo phạm vi hồ sơ và nhu cầu đồng hành</label><p class="muted">Email và số điện thoại không tự xuất hiện trong kết quả tìm kiếm. Trạng thái xác minh không thay đổi khi sửa hồ sơ.</p>
@if(Model.Provider is {} provider){<hr/><h3>Liên hệ cơ sở</h3><p class="muted">Tên cơ sở (chỉ xem): <strong>@provider.CompanyName</strong><br/>Loại hình (chỉ xem): <strong>@provider.CompanyType</strong><br/>Xác minh (chỉ xem): <strong>@Model.Account.VerificationStatus</strong><br/>Quyền hoạt động (chỉ xem): <strong>@(Model.Account.ProviderStatus??"Chưa mở quyền")</strong></p><label>Người liên hệ<input asp-for="Input.ContactName" required maxlength="100"/></label><label>Địa chỉ<input asp-for="Input.Address" required maxlength="300"/></label><label>Điện thoại liên hệ<input asp-for="Input.ContactPhone" required type="tel" maxlength="30"/></label><label>Email liên hệ<input asp-for="Input.ContactEmail" required type="email" maxlength="200"/></label><p><a class="secondary" href="/Verification/Mine">Xem và bổ sung hồ sơ xác minh ↗</a></p>}
<button class="button">Lưu hồ sơ</button><a asp-action="Profile" class="secondary">Hủy chỉnh sửa</a></form><div><div class="panel"><h2>Không gian của bạn</h2><p><a class="secondary" href="/Journey">Chuyến đi của tôi ↗</a><a class="secondary" href="/Community/Dashboard">Kết nối đồng hành ↗</a><a class="secondary" href="/Marketplace/Requests">Yêu cầu dịch vụ ↗</a></p>@if(Model.Account.Role=="Provider"){<p class="badge-status">@Model.Account.VerificationStatus · @(Model.Account.ProviderStatus??"Chưa mở quyền hoạt động")</p><p><a class="button" href="/Provider">Quản lý dịch vụ ↗</a><a class="secondary" href="/Verification/Mine">Hồ sơ xác minh ↗</a></p>}@if(Model.Account.Role=="Admin"){<a class="button" href="/Admin">Trang quản trị ↗</a><a class="secondary" href="/Verification">Xác minh nhà cung cấp ↗</a>}</div><form asp-action="ChangePassword" method="post" class="panel"><h2>Đổi mật khẩu</h2><label>Mật khẩu hiện tại<input name="currentPassword" type="password" autocomplete="current-password" required/></label><label>Mật khẩu mới<input name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="100"/></label><label>Nhập lại mật khẩu mới<input name="confirmPassword" type="password" autocomplete="new-password" required/></label><p class="muted">Từ 8–100 ký tự, có chữ và số, không chứa email. Các phiên đăng nhập trước sẽ hết hiệu lực.</p><button class="secondary">Cập nhật mật khẩu</button></form>@if(Model.Account.Role!="Admin"){<div class="panel"><h3>Ngừng sử dụng tài khoản</h3><p class="muted">Xác thực lại, kiểm tra nghĩa vụ và xem hệ quả trước khi quyết định. Dữ liệu lịch sử được giữ lại.</p><a asp-action="Deactivate" class="secondary" style="color:#a3392f">Bắt đầu kiểm tra điều kiện ↗</a></div>}</div></div></section>
<style>.check-label{display:flex;align-items:center;gap:10px;line-height:1.5}.check-label input{width:17px;margin:0}.validation-error,.field-validation-error{color:#a3392f;font-size:13px}</style>
