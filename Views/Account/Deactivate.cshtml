@model DeactivationPage
@{ViewData["Title"]="Ngừng sử dụng tài khoản";}
<section class="section narrow"><span class="eyebrow">TÀI KHOẢN CỦA BẠN</span><h1>Ngừng sử dụng tài khoản</h1><div asp-validation-summary="All" class="validation-error" role="alert"></div>
@if(Model.Obligations.Count>0){<div class="panel"><h2>Cần xử lý trước khi ngừng</h2><p>Tài khoản vẫn hoạt động. Chưa có trạng thái nào được thay đổi.</p>@foreach(var obligation in Model.Obligations){<p><a class="secondary" href="@obligation.Url">@obligation.Text ↗</a></p>}<a asp-action="Profile" class="button">Quay lại hồ sơ</a><a asp-action="Deactivate" class="secondary">Kiểm tra lại</a></div>}
else if(Model.Ready){<div class="panel"><h2>Xác nhận lần cuối</h2><p>Điều kiện ngừng đã được kiểm tra. Khi xác nhận:</p><ul><li>@Model.Demands nhu cầu đồng hành sẽ dừng công bố.</li><li>@Model.Connections đề nghị kết nối đang chờ sẽ hết hiệu lực; bên liên quan được thông báo.</li><li>@Model.Services dịch vụ sẽ không tiếp nhận yêu cầu mới.</li><li>Các phiên đăng nhập sẽ kết thúc. Lịch sử nghiệp vụ được giữ lại.</li></ul><p class="muted">Xác nhận có hiệu lực trong 5 phút. Hệ thống kiểm tra lại nghĩa vụ ngay trước khi ghi.</p><form asp-action="Deactivate" method="post"><input name="token" type="hidden" value="@Model.Token"/><input name="version" type="hidden" value="@Model.Version"/><button class="button" style="background:#a13d32">Tôi xác nhận ngừng sử dụng</button><a asp-action="Profile" class="secondary">Hủy, giữ tài khoản hoạt động</a></form></div>}
else{<form asp-action="Reauthenticate" method="post" class="panel"><h2>1. Xác thực lại</h2><p>Nhập mật khẩu để kiểm tra điều kiện ngừng. Bước này chỉ kiểm tra, chưa thay đổi tài khoản hay dữ liệu.</p><label>Mật khẩu hiện tại<input name="password" type="password" autocomplete="current-password" required/></label><button class="button">Kiểm tra điều kiện và xem hệ quả</button><a asp-action="Profile" class="secondary">Hủy</a></form>}
</section>
