@model RegisterInput
@{ViewData["Title"]="Tạo tài khoản";}
<section class="section narrow"><span class="eyebrow">BẮT ĐẦU HÀNH TRÌNH CỦA BẠN</span><h1>Tạo tài khoản mới</h1><form asp-action="Register" method="post" enctype="multipart/form-data" class="panel"><div asp-validation-summary="All" class="validation-error" role="alert"></div><label>Vai trò tài khoản<select asp-for="Role" id="register-role"><option value="Traveler">Khách du lịch tự túc</option><option value="Provider">Nhà cung cấp dịch vụ</option></select></label><div class="account-fields"><label>Họ và tên<input asp-for="Name" autocomplete="name" required maxlength="100"/><span asp-validation-for="Name"></span></label><label>Email đăng nhập<input asp-for="Email" type="email" autocomplete="email" required maxlength="200"/><span asp-validation-for="Email"></span></label><label>Số điện thoại<input asp-for="Phone" type="tel" required placeholder="09xxxxxxxx hoặc +84…" maxlength="30"/><span asp-validation-for="Phone"></span></label></div><div class="account-fields"><label>Mật khẩu<input asp-for="Password" type="password" autocomplete="new-password" required minlength="8" maxlength="100"/></label><label>Nhập lại mật khẩu<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/></label></div><p class="muted">Mật khẩu từ 8–100 ký tự, gồm chữ và số, không chứa email của bạn.</p><fieldset id="provider-fields"><legend>Thông tin cơ sở và hồ sơ xác minh</legend><p class="muted">Thông tin này chỉ dùng phục vụ xác minh. Tài liệu được lưu riêng và chỉ bạn cùng Admin có quyền tải.</p><div class="account-fields"><label>Tên cơ sở<input asp-for="CompanyName" maxlength="200"/></label><label>Loại hình<input asp-for="CompanyType" maxlength="50" placeholder="Lưu trú, vận chuyển, hướng dẫn…"/></label><label>Người liên hệ<input asp-for="ContactName" maxlength="100"/></label><label>Điện thoại liên hệ<input asp-for="ContactPhone" type="tel" maxlength="30"/></label><label>Email liên hệ<input asp-for="ContactEmail" type="email" maxlength="200"/></label><label>Địa chỉ cơ sở<input asp-for="Address" maxlength="300"/></label></div><label>Người đứng tên hồ sơ<input asp-for="Representative" maxlength="100"/></label><label>Nội dung đăng ký<textarea asp-for="DossierContent" maxlength="2000" placeholder="Giới thiệu cơ sở, phạm vi cung cấp và tài liệu chứng minh."></textarea></label><label>Tài liệu xác minh (1–5 tệp PDF/JPG/PNG, tối đa 5 MB/tệp)<input asp-for="Files" type="file" accept=".pdf,.jpg,.jpeg,.png" multiple/></label></fieldset><button class="button" type="submit">Đăng ký tài khoản ↗</button><a asp-action="Login" class="secondary">Đã có tài khoản</a><a href="/" class="secondary">Hủy</a></form></section>
<style>.account-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.validation-error,.field-validation-error{color:#a3392f;font-size:13px}fieldset{border:1px solid #d7dfd0;border-radius:10px;padding:24px;margin:24px 0}legend{float:none;width:auto;padding:0 10px;font-size:18px}@@media(max-width:650px){.account-fields{grid-template-columns:1fr}}</style>
<script>(()=>{const role=document.getElementById('register-role'),section=document.getElementById('provider-fields');function update(){const show=role.value==='Provider';section.hidden=!show;section.disabled=!show;section.querySelectorAll('input,textarea').forEach(x=>x.required=show)}role.addEventListener('change',update);update()})();</script>
