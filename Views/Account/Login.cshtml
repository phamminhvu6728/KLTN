@model LoginInput
@{ViewData["Title"]="Đăng nhập";}
<section class="section auth-page">
 <div class="auth-heading"><span class="eyebrow">HỆ THỐNG HỖ TRỢ DU LỊCH TỰ TÚC</span><h1>Đăng nhập tài khoản</h1><p class="muted">Đăng nhập để lưu chuyến đi, kết nối bạn đồng hành và trao đổi dịch vụ.</p></div>
 <div class="cards"><form asp-action="Login" method="post" class="panel"><h2>Đăng nhập tài khoản</h2><div asp-validation-summary="All" class="validation-error" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/><label>Email hoặc số điện thoại<input asp-for="Email" type="text" autocomplete="username" placeholder="ban@email.com hoặc 09xxxxxxxx" required/></label><label>Mật khẩu<input asp-for="Password" type="password" autocomplete="current-password" required/></label><button class="button" type="submit">Đăng nhập ↗</button><p class="muted" style="margin-top:18px">Chưa có tài khoản? <a asp-action="Register" style="text-decoration:underline">Tạo tài khoản mới</a></p></form>
 <div class="panel auth-demo"><span class="eyebrow">KHÁM PHÁ NGAY</span><h2>Chọn vai trò để xem demo</h2><p>Thử đầy đủ hành trình của khách du lịch, nhà cung cấp hoặc người quản trị.</p>
 @if(ViewBag.DemoEnabled==true){<div class="demo-roles"><form asp-action="LoginDemo" method="post"><input type="hidden" name="role" value="Traveler"/><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="role-card" type="submit"><span><partial name="_TravelIcon" model='@("calendar")'/></span><strong>Khách du lịch</strong><small>Lên lịch trình · Tìm bạn · Yêu cầu dịch vụ</small><b>↗</b></button></form><form asp-action="LoginDemo" method="post"><input type="hidden" name="role" value="Provider"/><button class="role-card" type="submit"><span><partial name="_TravelIcon" model='@("map")'/></span><strong>Nhà cung cấp</strong><small>Đăng dịch vụ · Xử lý yêu cầu · Ghi kết quả</small><b>↗</b></button></form><form asp-action="LoginDemo" method="post"><input type="hidden" name="role" value="Admin"/><button class="role-card" type="submit"><span><partial name="_TravelIcon" model='@("shield")'/></span><strong>Quản trị viên</strong><small>Xác minh nhà cung cấp · Duyệt dịch vụ</small><b>↗</b></button></form></div>}else{<a asp-action="Register" class="button">Tạo tài khoản để bắt đầu</a>}
 <a href="/" class="secondary">Tiếp tục khám phá không cần đăng nhập</a></div></div>
</section>
<style>.auth-page{max-width:1120px}.auth-heading{margin-bottom:30px}.auth-demo{background:#eef3e6}.demo-roles form{margin-bottom:12px}.role-card{display:grid;grid-template-columns:36px 1fr 18px;gap:2px 12px;text-align:left;align-items:center;width:100%;border:1px solid #d3dfc5;background:#fff;padding:16px;border-radius:10px;color:#183f37;cursor:pointer}.role-card>span{grid-row:1/3;font-size:27px}.role-card>strong{font-size:15px}.role-card>small{font-size:11px;grid-column:2}.role-card>b{grid-column:3;grid-row:1/3}.role-card:hover{border-color:#205747;background:#f7faef}.validation-error{color:#a3392f;font-size:13px}.validation-error ul{padding-left:18px}.auth-page input{font-size:14px}</style>

