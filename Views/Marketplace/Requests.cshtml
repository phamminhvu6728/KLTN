@model RequestListVm
@using TuTuc.Services
@{ViewData["Title"]=Model.IsProvider?"Yêu cầu & thực hiện dịch vụ":"Yêu cầu dịch vụ của tôi";ViewData["ShowTotal"]=true;
BookingTermsInput Terms(Booking b)=>Model.DraftBookingId==b.Id&&Model.DraftTerms!=null?Model.DraftTerms:new(){Date=b.Date,EndDate=b.EndDate,People=b.People,Guests=b.Guests,Total=b.Total,Options=b.Options,ArrivalDeparture=b.ArrivalDeparture,Note=b.Note};
BookingTermsInput ProposalTerms(BookingChange c)=>new(){Date=c.Date,EndDate=c.EndDate,People=c.People,Guests=c.Guests,Total=c.Total,Options=c.Options,ArrivalDeparture=c.ArrivalDeparture};}
<section class="section requests-heading"><div class="page-heading"><div><span class="eyebrow">@(Model.IsProvider?"KHU VỰC NHÀ CUNG CẤP":"Khách du lịch")</span><h1>@ViewData["Title"]</h1><p class="muted">Theo dõi điều kiện, phản hồi và lịch sử của từng yêu cầu.</p></div><a class="secondary" href="@(Model.IsProvider?"/Provider":"/Marketplace")">@(Model.IsProvider?"← Dịch vụ của tôi":"+ Tìm dịch vụ")</a></div>
<div asp-validation-summary="All" role="alert" data-error-code="@ViewData["BusinessErrorCode"]"></div>
<form method="get" class="toolbar"><label>Lọc trạng thái<select name="trangThai"><option value="">Tất cả</option>@foreach(var state in new[]{"Chờ phản hồi","Đề xuất khác","Đã xác nhận","Từ chối","Không tiếp tục","Chờ kiểm tra","Hoàn thành","Thực hiện một phần","Không thực hiện"}){<option selected="@(Model.StatusFilter==state)">@state</option>}</select></label><button class="secondary">Lọc yêu cầu</button></form>
<div class="request-status-strip"><span><strong>@Model.Bookings.Count.ToString("00")</strong> yêu cầu</span><span><strong>@Model.Bookings.Count(x=>MarketplaceManager.PendingBookingStates.Contains(x.Status)).ToString("00")</strong> đang trao đổi</span><span><strong>@Model.Bookings.Count(x=>x.Status=="Đã xác nhận").ToString("00")</strong> đã xác nhận</span></div>
<div class="request-guide"><strong>Từ yêu cầu đến thỏa thuận dịch vụ</strong><p>Gửi yêu cầu → Nhà cung cấp phản hồi → Nếu có đề xuất khác, khách chấp thuận đúng phiên bản để xác nhận thỏa thuận. Chỉ trạng thái “Đã xác nhận” mới là thỏa thuận dịch vụ.</p></div>
@if(!Model.Bookings.Any()){<div class="empty"><h3>Chưa có yêu cầu dịch vụ</h3><p>Yêu cầu và phản hồi sẽ được hiển thị tại đây.</p></div>}
<div class="request-workspace"><aside class="request-navigation" aria-label="Chọn yêu cầu"><div class="request-navigation-title"><partial name="_TravelIcon" model='@("bag")'/><strong>Yêu cầu trên trang</strong></div>@foreach(var entry in Model.Bookings){<a class="@(Model.Bookings.Count==1?"selected":"")" href="@(Model.IsProvider?"/Provider/Request/":"/Marketplace/Request/")@entry.Id"><small>#@entry.Id · @entry.Date.ToString("dd/MM/yyyy")</small><strong>@(string.IsNullOrEmpty(entry.SnapshotName)?entry.TravelService?.Name:entry.SnapshotName)</strong><span class="badge-status @(entry.Status=="Đã xác nhận"?"status-confirmed":MarketplaceManager.PendingBookingStates.Contains(entry.Status)?"status-attention":"status-draft")">@entry.Status</span></a>}<a class="request-all-link" href="@(Model.IsProvider?"/Provider/Requests":"/Marketplace/Requests")">Về danh sách yêu cầu →</a></aside><div class="request-records">
@foreach(var b in Model.Bookings)
{
 var changes=Model.Changes.Where(x=>x.BookingId==b.Id).ToList();var version=Convert.ToBase64String(b.Version);var results=Model.Results.Where(x=>x.BookingId==b.Id).ToList();var items=MarketplaceManager.Items(b);var activeChange=changes.Any(x=>MarketplaceManager.ActiveChangeStates.Contains(x.Status));var editable=items.Where(x=>!results.Any(r=>r.ItemKey==x.Key&&r.Outcome!="Chưa xác định"&&r.VerificationStatus!="Chờ kiểm tra")).ToList();
 <article class="panel booking-item request-record" id="request-@b.Id" data-testid="request-@b.Id" data-request-status="@b.Status"><div class="section-heading"><div><span class="badge-status @(b.Status=="Đã xác nhận"?"status-confirmed":MarketplaceManager.PendingBookingStates.Contains(b.Status)?"status-attention":"status-draft")">@b.Status</span><h2>#@b.Id · @(string.IsNullOrEmpty(b.SnapshotName)?b.TravelService?.Name:b.SnapshotName)</h2><p class="muted">@(Model.IsProvider?"Khách: "+Model.PeopleNames.GetValueOrDefault(b.OwnerId,"Người dùng"):"Nhà cung cấp: "+Model.PeopleNames.GetValueOrDefault(b.TravelService?.OwnerId??0,"Nhà cung cấp")) · Điều kiện phiên bản @b.ConditionsVersion</p></div><strong style="font-size:24px">@b.Total.ToString("N0") ₫</strong></div><div class="booking-facts"><span>Thời gian <strong>@b.Date.ToString("dd/MM/yyyy") – @(b.EndDate?.ToString("dd/MM/yyyy")??b.Date.ToString("dd/MM/yyyy"))</strong></span><span>Khách / Số lượng <strong>@b.Guests người · @b.People đơn vị</strong></span><span>Giờ mong muốn <strong>@b.ArrivalDeparture</strong></span></div>@if(Model.IsProvider&&b.Status=="Đã xác nhận"&&Model.CustomerContacts.TryGetValue(b.OwnerId,out var contact)){<p><strong>Liên hệ khách đã xác nhận:</strong> @contact</p>}<p><a href="@(Model.IsProvider?"/Provider/Request/":"/Marketplace/Request/")@b.Id">Mở riêng yêu cầu #@b.Id</a></p><p style="white-space:pre-line">@b.Note</p><p><strong>Hạng mục đang trao đổi / đã thỏa thuận</strong></p><ul>@foreach(var item in items){<li>@item.Title</li>}</ul>@if(!string.IsNullOrEmpty(b.ProviderOfferReason)){<p class="notice">Đề xuất từ nhà cung cấp: @b.ProviderOfferReason</p>}@if(!string.IsNullOrEmpty(b.ResponseReason)){<p>Phản hồi: @b.ResponseReason</p>}
 @if(Model.IsProvider&&new[]{"Chờ phản hồi","Chờ xác nhận","Chờ NCC xác nhận cuối"}.Contains(b.Status))
 {
 <form asp-controller="Provider" asp-action="Respond" method="post"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/><input type="hidden" name="conditionsVersion" value="@b.ConditionsVersion"/><label>Phản hồi / lý do từ chối<input name="reason" maxlength="500" placeholder="Bắt buộc khi từ chối"/></label><button class="button" name="decision" value="Đã xác nhận">@(b.Status=="Chờ NCC xác nhận cuối"?"Xác nhận lần cuối đúng phiên bản":"Chấp nhận đúng điều kiện khách gửi")</button><button class="secondary" name="decision" value="Từ chối">Từ chối</button></form>
 <details open="@(Model.DraftBookingId==b.Id&&Model.DraftDecision=="Đề xuất khác")"><summary>Đề xuất điều kiện khác</summary><form asp-controller="Provider" asp-action="Respond" method="post" class="change-form"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/><input type="hidden" name="conditionsVersion" value="@b.ConditionsVersion"/><input type="hidden" name="decision" value="Đề xuất khác"/><partial name="~/Views/Marketplace/_Terms.cshtml" model="Terms(b)"/><label>Lời giải thích đề xuất<textarea name="reason" required maxlength="2000">@(Model.DraftBookingId==b.Id?Model.DraftReason:"")</textarea></label><button class="button">Gửi bản điều kiện khác cho khách</button></form></details>
 }
 @if(!Model.IsProvider&&MarketplaceManager.PendingBookingStates.Contains(b.Status))
 {
 @if(b.Status=="Đề xuất khác"){<form asp-action="ReplyOffer" method="post"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/><input type="hidden" name="conditionsVersion" value="@b.ConditionsVersion"/><button class="button" name="accept" value="true">Chấp thuận phiên bản @b.ConditionsVersion</button><button class="secondary" name="accept" value="false">Không đồng ý · Kết thúc yêu cầu</button></form>}
 @if(b.Status=="Chờ NCC xác nhận cuối"){<p class="notice">Bạn đã chấp thuận bản đề xuất. Đang chờ nhà cung cấp xác nhận lần cuối đúng phiên bản; chưa phải đặt thành công.</p>}
 <form asp-action="Withdraw" method="post" style="margin-top:15px"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/><button class="secondary">Rút yêu cầu chưa xác nhận</button></form>
 @if(new[]{"Chờ phản hồi","Chờ xác nhận","Đề xuất khác"}.Contains(b.Status)){<details><summary>Sửa yêu cầu đang chờ</summary><form asp-action="EditPending" method="post" class="change-form"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/><input type="hidden" name="conditionsVersion" value="@b.ConditionsVersion"/><partial name="~/Views/Marketplace/_Terms.cshtml" model="Terms(b)"/><button class="button">Lưu và gửi lại phiên bản mới</button></form></details>}
 }
 @if(!Model.IsProvider&&b.Status=="Đã xác nhận"&&b.Date.Date>MarketplaceManager.Today&&!results.Any()&&string.IsNullOrEmpty(b.Result)&&!activeChange)
 {
 <details><summary>Đề nghị thay đổi hoặc hủy thỏa thuận</summary><form asp-action="ProposeChange" method="post" class="change-form"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/><input type="hidden" name="conditionsVersion" value="@b.ConditionsVersion"/><label>Loại đề nghị<select name="kind"><option>Điều chỉnh</option><option>Hủy</option></select></label><partial name="~/Views/Marketplace/_Terms.cshtml" model="Terms(b)"/><label>Lý do đề nghị<textarea name="reason" maxlength="500" required></textarea></label><button class="button">Gửi đề nghị · Giữ nguyên thỏa thuận hiện tại</button></form></details>
 }
 @foreach(var c in changes)
 {
 <div class="change-item" id="change-@c.Id"><span class="badge-status">Đề nghị @c.Kind.ToLower() · @c.Status · bản @c.LogicalVersion</span><p>@c.Reason</p><details><summary>Điều kiện cũ được giữ để đối chiếu</summary><p>@MarketplaceManager.DescribeSnapshot(c.OldConditions)</p></details>@if(c.Kind=="Điều chỉnh"){<p><strong>Điều kiện đề nghị:</strong> @c.Date.ToString("dd/MM/yyyy")–@c.EndDate?.ToString("dd/MM/yyyy") · @c.Guests người · @c.People đơn vị · @c.Total.ToString("N0") ₫</p><p style="white-space:pre-line">@c.Options</p>}<p>@c.ProviderOfferReason @c.DecisionReason</p>
 @if(Model.IsProvider&&c.Status=="Chờ phản hồi")
 {
 <form asp-controller="Provider" asp-action="ReplyChange" method="post"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)"/><input type="hidden" name="logicalVersion" value="@c.LogicalVersion"/><label>Phản hồi / lý do từ chối<input name="reason" maxlength="500"/></label><button class="button" name="decision" value="Chấp nhận">Chấp nhận đề nghị</button><button class="secondary" name="decision" value="Từ chối">Từ chối</button></form>
 @if(c.Kind=="Điều chỉnh"){<details><summary>Đề xuất điều kiện thay thế cho khách</summary><form asp-controller="Provider" asp-action="ReplyChange" method="post" class="change-form"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)"/><input type="hidden" name="logicalVersion" value="@c.LogicalVersion"/><input type="hidden" name="decision" value="Đề xuất khác"/><partial name="~/Views/Marketplace/_Terms.cshtml" model="ProposalTerms(c)"/><label>Giải thích điều kiện thay thế<textarea name="reason" required maxlength="2000">@(Model.DraftBookingId==b.Id?Model.DraftReason:"")</textarea></label><button class="button">Gửi đề xuất khác · Chưa đổi thỏa thuận</button></form></details>}
 }
 @if(!Model.IsProvider&&MarketplaceManager.ActiveChangeStates.Contains(c.Status)){<form asp-action="ReplyChangeOffer" method="post"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)"/><input type="hidden" name="logicalVersion" value="@c.LogicalVersion"/>@if(c.Status=="Đề xuất khác"){<button class="button" name="accept" value="true">Đồng ý điều kiện thay thế bản @c.LogicalVersion</button>}<button class="secondary" name="accept" value="false">Rút đề nghị · Giữ thỏa thuận cũ</button></form>}
 </div>
 }
 @if(results.Any())
 {
 <h3 style="margin-top:25px">Kết quả thực hiện theo hạng mục</h3><p class="muted">Kết quả thực hiện và trạng thái kiểm tra được theo dõi riêng. Chưa phản hồi không đồng nghĩa khách đã xác nhận.</p>
 @foreach(var r in results){<div class="change-item" id="result-@r.Id"><strong>@r.ItemTitle</strong><p><span class="badge-status">@r.Outcome</span> <span class="badge-status">@r.VerificationStatus</span></p><p>Căn cứ: @r.Note</p><small>Ghi nhận @r.RecordedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small>@if(!string.IsNullOrEmpty(r.Feedback)){<p><strong>Phản ánh riêng của khách:</strong> @r.Feedback</p>}else if(!Model.IsProvider&&r.RecordedAt.AddHours(7).Date.AddDays(Model.FeedbackWindowDays)>=MarketplaceManager.Today){<form asp-action="FeedbackItem" method="post"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="version" value="@Convert.ToBase64String(r.Version)"/><label>Phản ánh sai khác của hạng mục<textarea name="feedback" required maxlength="2000"></textarea></label><button class="secondary">Gửi phản ánh · Chuyển chờ kiểm tra</button><p class="muted">Theo thiết kế: phản ánh trong @Model.FeedbackWindowDays ngày sau ghi nhận kết quả.</p></form>}@foreach(var h in Model.ResultHistory.Where(x=>x.BookingItemResultId==r.Id)){<details><summary>Lịch sử đối chiếu @h.CreatedAt.AddHours(7).ToString("dd/MM HH:mm")</summary><p>Trước: @h.PreviousOutcome · @h.PreviousNote</p><p>Sau: @h.NewOutcome · Căn cứ @h.Evidence</p></details>}</div>}
 
 }
 @if(Model.IsProvider&&new[]{"Đã xác nhận","Chờ kiểm tra","Chưa chốt"}.Contains(b.Status)&&b.Date.Date<=MarketplaceManager.Today&&editable.Any())
 {
 <details open="@(b.Status=="Chờ kiểm tra")"><summary>Ghi nhận / đối chiếu từng hạng mục chưa chốt</summary><form asp-controller="Provider" asp-action="Results" method="post" class="change-form"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="version" value="@version"/>@for(var i=0;i<editable.Count;i++){var item=editable[i];var previous=results.FirstOrDefault(x=>x.ItemKey==item.Key);<div class="change-item"><strong>@item.Title</strong><input type="hidden" name="items[@i].ItemKey" value="@item.Key"/><label>Kết quả thực tế<select name="items[@i].Outcome" required><option value="">Chọn kết quả</option>@foreach(var outcome in MarketplaceManager.Outcomes){<option value="@outcome" selected="@(previous?.Outcome==outcome)">@outcome</option>}</select></label><label>Ghi chú / căn cứ thực tế<textarea name="items[@i].Note" required maxlength="1000">@previous?.Note</textarea></label></div>}<button class="button">Lưu đầy đủ kết quả hạng mục</button></form></details>
 }
 <details><summary>Lịch sử các phiên bản điều kiện</summary>@foreach(var history in Model.History.Where(x=>x.BookingId==b.Id)){<div class="change-item"><strong>Phiên bản @history.VersionNumber · @history.Reason</strong><p>@MarketplaceManager.DescribeSnapshot(history.Snapshot)</p><small>@history.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small></div>}</details>
 </article>
}
</div></div>
@if(Model.TotalCount>20){<nav class="toolbar" aria-label="Phân trang yêu cầu">@if(Model.Page>1){<a class="secondary" href="?trang=@(Model.Page-1)&trangThai=@Uri.EscapeDataString(Model.StatusFilter??"")">← Trang trước</a>}<span class="muted">Trang @Model.Page / @((Model.TotalCount+19)/20)</span>@if((long)Model.Page*20<Model.TotalCount){<a class="secondary" href="?trang=@(Model.Page+1)&trangThai=@Uri.EscapeDataString(Model.StatusFilter??"")">Trang sau →</a>}</nav>}
</section><style>.booking-facts{display:flex;gap:35px;padding:18px 0;border-top:1px solid #e4e8df;border-bottom:1px solid #e4e8df;margin-bottom:15px}.booking-facts span{font-size:12px;color:#738070}.booking-facts strong{display:block;color:#183f37;font-size:15px;margin-top:5px}.change-item{background:#f5f7f0;padding:20px;border-radius:8px;margin:18px 0}.change-form{padding:20px 0}.booking-item details{padding:10px 0}.market-terms-grid,.market-compare{display:grid;grid-template-columns:1fr 1fr;gap:20px}@@media(max-width:640px){.booking-facts{gap:20px;flex-wrap:wrap}.market-terms-grid,.market-compare{grid-template-columns:1fr}}</style>

