@model BookingTermsInput
@{var showTotal=ViewData["ShowTotal"] as bool? ?? true;var lodging=ViewData["ServiceCategory"] as string=="Lưu trú";}
<fieldset class="terms-section"><legend>Thời gian và số lượng</legend><div class="market-terms-grid"><label>@(lodging?"Ngày nhận phòng":"Ngày bắt đầu")<input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" required/></label><label>@(lodging?"Ngày trả phòng (nếu có)":"Ngày kết thúc (nếu có)")<input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")"/></label><label>Số người<input type="number" name="Guests" min="1" max="100" value="@Model.Guests" required/></label><label>@(lodging?"Số phòng":"Số lượng (đơn vị dịch vụ)")<input type="number" name="People" min="1" max="100" value="@Model.People" required/></label></div></fieldset>
<label>Giờ đến/đi hoặc thời gian mong muốn<input name="ArrivalDeparture" maxlength="100" value="@Model.ArrivalDeparture" placeholder="Ví dụ: nhận phòng 14:00, trả phòng 11:00"/></label><label>Hạng mục chọn thêm (mỗi dòng một hạng mục, tối đa 10)<textarea name="Options" maxlength="1000" placeholder="Ví dụ: đón tại bến xe&#10;Bữa sáng cho 2 người">@Model.Options</textarea></label>
@if(showTotal){<label>Tổng chi phí điều kiện đang trao đổi (₫)<input type="number" name="Total" min="0" max="1000000000" value="@Model.Total.ToString("0")" required/></label>}
<label>Ghi chú riêng<textarea name="Note" maxlength="1000">@Model.Note</textarea></label>
