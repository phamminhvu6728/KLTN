@model TravelService
@using TuTuc.Services
@{
 ViewData["Title"]=Model.Name;var provider=(Account)ViewBag.Provider;var canReceive=(bool)ViewBag.CanReceive;
 var terms=ViewBag.Terms as BookingTermsInput??new BookingTermsInput{Service=Model.Id,Date=MarketplaceManager.Today.AddDays(1)};
 if(terms.Operation==Guid.Empty)terms.Operation=Guid.NewGuid();ViewData["ShowTotal"]=false;ViewData["ServiceCategory"]=Model.Category;
}
<section class="section service-detail-page">
 <div class="breadcrumb-line"><a href="/Marketplace">Dịch vụ địa phương</a><span>/</span><span>@Model.Category</span><span>/</span><span>#@Model.Id</span></div>
 <div class="service-title"><span class="eyebrow">CHI TIẾT DỊCH VỤ</span><h1>@Model.Name</h1><p class="service-meta"><span><partial name="_TravelIcon" model='@("pin")'/>@Model.Location</span><span><partial name="_TravelIcon" model='@("user")'/>@provider.Name</span><span class="badge-status @(canReceive?"status-confirmed":"status-draft")">@(canReceive?"Đang tiếp nhận yêu cầu":"Không tiếp nhận yêu cầu mới")</span></p></div>
 <div class="service-detail-grid"><article class="service-story"><img class="service-story-image" src="@(string.IsNullOrEmpty(Model.Image)?TravelPresentation.Cover(Model.Location):Model.Image)" alt="Ảnh minh họa dịch vụ @Model.Name" onerror="this.onerror=null;this.src='/images/dalat.jpg'"/><p class="story-caption">Ảnh minh họa điểm đến và trải nghiệm.</p><h2>Thông tin dịch vụ</h2><p style="white-space:pre-line">@Model.Description</p><div class="service-conditions"><div><span><partial name="_TravelIcon" model='@("clock")'/>Thời gian phục vụ</span><p>@(string.IsNullOrEmpty(Model.ServingHours)?"Theo thỏa thuận với nhà cung cấp":Model.ServingHours)</p></div><div><span><partial name="_TravelIcon" model='@("note")'/>Điều kiện dịch vụ</span><p>@(string.IsNullOrEmpty(Model.Conditions)?"Hai bên thống nhất trước khi xác nhận":Model.Conditions)</p></div></div>
 @if(Model.ClosureStart.HasValue){<div class="notice"><strong>Tạm ngừng đã được duyệt</strong><p>@Model.ClosureStart.Value.ToString("dd/MM/yyyy") – @(Model.ClosureEnd?.ToString("dd/MM/yyyy")??"đến khi có thông báo mới")</p><p>@Model.ClosureReason · @Model.ClosureScope</p></div>}
 <div class="supplier-signature"><span class="avatar"><partial name="_TravelIcon" model='@("user")'/></span><div><strong>@provider.Name</strong><small>Nhà cung cấp dịch vụ tại @Model.Location</small></div></div><p class="service-explanation">Bạn sẽ gửi yêu cầu để nhà cung cấp xem xét khả năng phục vụ. Chỉ khi hai bên thống nhất và xác nhận cùng điều kiện, yêu cầu mới trở thành thỏa thuận dịch vụ.</p><a class="text-link" href="/Journey/ChooseSource?sourceType=Service&sourceId=@Model.Id"><partial name="_TravelIcon" model='@("calendar")'/>Thêm dịch vụ vào kế hoạch dự kiến</a>
 </article><article class="panel booking-sheet"><div class="booking-unit-price"><strong>@Model.Price.ToString("N0") đ</strong><span>/ đơn vị dịch vụ</span></div><span class="eyebrow">BƯỚC 01 — ĐIỀU KIỆN MONG MUỐN</span><h2>Gửi yêu cầu dịch vụ</h2><p class="field-hint">Chọn thời gian và số lượng. Bạn sẽ được xem lại toàn bộ thông tin trước khi gửi.</p><div asp-validation-summary="All" role="alert" data-testid="request-errors"></div>
 <form asp-action="Preview" method="post" data-testid="request-form" data-unit-price="@Model.Price.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"><input type="hidden" name="Service" value="@Model.Id"/><input type="hidden" name="Operation" value="@terms.Operation"/><partial name="~/Views/Marketplace/_Terms.cshtml" model="terms"/><div class="estimate-row"><span>Tổng dự kiến</span><output data-estimate>@((Model.Price*terms.People).ToString("N0")) đ</output></div>
 @if(canReceive){@if(User.IsInRole("Traveler")){<button class="button full-width">Tiếp tục kiểm tra yêu cầu <partial name="_TravelIcon" model='@("arrow")'/></button>}else if(User.Identity?.IsAuthenticated!=true){<a class="button full-width" href="/Account/Login?returnUrl=/Marketplace/Details/@Model.Id">Đăng nhập khách để gửi yêu cầu</a>}else{<p class="notice">Chỉ tài khoản khách du lịch được gửi yêu cầu.</p>}}else{<p class="notice">Không tiếp nhận yêu cầu mới. Nội dung được giữ để tham khảo.</p>}
 <p class="form-bottom-note"><partial name="_TravelIcon" model='@("shield")'/>Tổng ban đầu tính theo số lượng đơn vị. Chưa bao gồm phụ phí hoặc điều chỉnh cần hai bên thống nhất; gửi yêu cầu chưa bảo đảm còn chỗ.</p></form></article></div>
</section>
