@model MarketCatalogVm
@using TuTuc.Services
@{ViewData["Title"]="Dịch vụ địa phương";var providers=ViewBag.Providers as Dictionary<int,Account>??new Dictionary<int,Account>();}
<section class="section catalog-page">
 <div class="catalog-header"><div><span class="eyebrow">DỊCH VỤ DU LỊCH</span><h1>Tìm dịch vụ cho chuyến đi</h1><p>Lọc dịch vụ theo địa điểm, loại và khoảng giá. Gửi yêu cầu để thống nhất điều kiện với nhà cung cấp.</p></div><div class="catalog-index">@Model.Services.Count.ToString("00")<small>DỊCH VỤ PHÙ HỢP</small></div></div>
 <form method="get" class="catalog-toolbar"><label>Tìm dịch vụ hoặc địa điểm<input name="q" value="@Model.Query" placeholder="Homestay, Đà Lạt, hướng dẫn viên…"/></label><label>Loại dịch vụ<select name="category"><option value="">Tất cả dịch vụ</option>@foreach(var c in new[]{"Trải nghiệm","Lưu trú","Di chuyển","Ăn uống"}){<option value="@c" selected="@(c==Model.Category)">@c</option>}</select></label><label>Giá từ (₫)<input type="number" name="minPrice" min="0" value="@Model.MinPrice" placeholder="Từ"/></label><label>Giá đến (₫)<input type="number" name="maxPrice" min="0" value="@Model.MaxPrice" placeholder="Đến"/></label><button class="button"><partial name="_TravelIcon" model='@("search")'/>Tìm kiếm</button></form>
 @if(!string.IsNullOrEmpty(Model.Error)){<p class="notice">@Model.Error</p>}
 <div class="catalog-results-head"><span><strong>@Model.Services.Count</strong> dịch vụ đã duyệt <span>·</span> Giá tham khảo theo đơn vị</span><a href="/Marketplace/Requests" class="text-link">Yêu cầu của tôi <partial name="_TravelIcon" model='@("arrow")'/></a></div>
 @if(!string.IsNullOrEmpty(Model.Query)||!string.IsNullOrEmpty(Model.Category)||Model.MinPrice.HasValue||Model.MaxPrice.HasValue){<p><a class="text-link" href="/Marketplace">Xóa bộ lọc →</a></p>}
 <div class="catalog-grid">@foreach(var s in Model.Services){var receives=providers.ContainsKey(s.OwnerId)&&ProviderRules.CanReceiveNew(s,providers[s.OwnerId]);
 <article class="service-card"><a class="service-card-photo" href="/Marketplace/Details/@s.Id" tabindex="-1" aria-hidden="true"><img src="@(string.IsNullOrEmpty(s.Image)?TravelPresentation.Cover(s.Location):s.Image)" alt="" loading="lazy" onerror="this.onerror=null;this.src='/images/dalat.jpg'"/><span class="photo-category">@s.Category</span><span class="photo-location"><partial name="_TravelIcon" model='@("pin")'/>@s.Location</span></a><div class="service-card-content"><span class="badge-status @(receives?"status-confirmed":"status-draft")">@(receives?"Đang tiếp nhận":"Không tiếp nhận yêu cầu mới")</span><h2><a href="/Marketplace/Details/@s.Id">@s.Name</a></h2><p class="muted">@(s.Description.Length>170?s.Description[..170]+"…":s.Description)</p><div class="service-card-footer"><strong>@s.Price.ToString("N0") đ <small>/ đơn vị</small></strong><a class="text-link" href="/Marketplace/Details/@s.Id">Xem dịch vụ <partial name="_TravelIcon" model='@("arrow")'/></a></div></div></article>}
 </div>
 @if(!Model.Services.Any()){<div class="empty"><partial name="_TravelIcon" model='@("search")'/><h3>Chưa tìm thấy dịch vụ phù hợp</h3><p>Thử tìm với tên địa điểm hoặc bỏ bớt bộ lọc.</p><a class="secondary" href="/Marketplace">Xóa bộ lọc</a></div>}
 <p class="catalog-disclaimer">Thông tin đã công bố không bảo đảm còn chỗ. Điều kiện cuối cùng cần được khách và nhà cung cấp cùng xác nhận.</p>
</section>
