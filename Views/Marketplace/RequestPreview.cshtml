@model BookingPreviewVm
@using TuTuc.Services
@{ViewData["Title"]="Kiểm tra yêu cầu";var t=Model.Terms;}
<section class="section narrow preview-page" data-testid="request-preview">
 <div class="request-steps"><span><b>1</b>Nhập điều kiện</span><i></i><span class="current"><b>2</b>Kiểm tra yêu cầu</span><i></i><span><b>3</b>Chờ phản hồi</span></div>
 <div class="page-heading"><span class="eyebrow">XEM LẠI TRƯỚC KHI GỬI</span><h1>Kiểm tra trước khi gửi</h1></div>
 <article class="panel preview-paper"><div class="preview-service"><img src="@(string.IsNullOrEmpty(Model.Service.Image)?TravelPresentation.Cover(Model.Service.Location):Model.Service.Image)" alt="Ảnh minh họa dịch vụ" onerror="this.onerror=null;this.src='/images/dalat.jpg'"/><div><small>@Model.Service.Location · @Model.Service.Category</small><h2>@Model.Service.Name</h2></div></div><div class="preview-body"><dl class="preview-terms"><div><dt>Ngày phục vụ</dt><dd>@t.Date.ToString("dd/MM/yyyy") – @(t.EndDate?.ToString("dd/MM/yyyy")??t.Date.ToString("dd/MM/yyyy"))</dd></div><div><dt>Số người và số lượng</dt><dd>@t.Guests người · @t.People đơn vị</dd></div><div class="terms-wide"><dt>Giờ mong muốn</dt><dd>@(string.IsNullOrWhiteSpace(t.ArrivalDeparture)?"Chưa có yêu cầu cụ thể":t.ArrivalDeparture)</dd></div><div class="terms-wide"><dt>Hạng mục thêm</dt><dd>@(string.IsNullOrWhiteSpace(t.Options)?"Không có hạng mục thêm":t.Options)</dd></div><div class="terms-wide"><dt>Ghi chú</dt><dd>@(string.IsNullOrWhiteSpace(t.Note)?"Không có ghi chú riêng":t.Note)</dd></div></dl><div class="preview-total"><span>Chi phí dự kiến</span><strong>@(t.Total.HasValue?t.Total.Value.ToString("N0")+" đ":"Chưa nhập")</strong></div>
 @foreach(var warning in Model.Warnings){<p class="notice">@warning</p>}
 <div class="preview-actions"><form asp-action="Book" method="post" data-testid="request-send-form"><input type="hidden" name="PreviewToken" value="@t.PreviewToken"/><input type="hidden" name="Service" value="@t.Service"/><input type="hidden" name="Operation" value="@t.Operation"/><input type="hidden" name="Version" value="@t.Version"/><input type="hidden" name="Date" value="@t.Date.ToString("yyyy-MM-dd")"/><input type="hidden" name="EndDate" value="@t.EndDate?.ToString("yyyy-MM-dd")"/><input type="hidden" name="People" value="@t.People"/><input type="hidden" name="Guests" value="@t.Guests"/><input type="hidden" name="Total" value="@t.Total?.ToString("0")"/><input type="hidden" name="Options" value="@t.Options"/><input type="hidden" name="ArrivalDeparture" value="@t.ArrivalDeparture"/><input type="hidden" name="Note" value="@t.Note"/><button class="button full-width">Tôi đã kiểm tra, xác nhận gửi <partial name="_TravelIcon" model='@("arrow")'/></button></form><form asp-action="EditPreview" method="post"><input type="hidden" name="previewToken" value="@t.PreviewToken"/><button class="secondary">← Quay lại sửa</button></form></div></div></article>
 <p class="preview-footnote">Chưa có yêu cầu nào được tạo ở bước này. Bản xem trước có hiệu lực 10 phút.<br/>Gửi yêu cầu chưa phải đặt thành công hoặc đã thanh toán. <a href="/Marketplace">Hủy, không gửi</a></p>
</section>
