@model TravelService
@using TuTuc.Services
@{ViewData["Title"]=Model.Name;var provider=(Account)ViewBag.Provider;var canReceive=(bool)ViewBag.CanReceive;var terms=ViewBag.Terms as BookingTermsInput??new BookingTermsInput{Service=Model.Id,Date=MarketplaceManager.Today.AddDays(1),People=1,Guests=1};ViewData["ShowTotal"]=false;}
<section class="section"><a href="/Marketplace" class="muted">← Tất cả dịch vụ</a><div class="detail-grid"><div><span class="eyebrow">@Model.Category · @Model.Location</span><h1>@Model.Name</h1><span class="badge-status">@provider.VerificationStatus · @provider.ProviderStatus</span><p style="white-space:pre-line">@Model.Description</p><p><strong>Thời gian phục vụ:</strong> @(string.IsNullOrEmpty(Model.ServingHours)?"Trao đổi theo yêu cầu":Model.ServingHours)</p><p><strong>Điều kiện phục vụ:</strong> @(string.IsNullOrEmpty(Model.Conditions)?"Hai bên cần thống nhất điều kiện trước khi xác nhận.":Model.Conditions)</p>@if(Model.ClosureStart.HasValue){<div class="notice"><strong>Tạm ngừng đã được xét duyệt</strong><p>@Model.ClosureStart.Value.ToString("dd/MM/yyyy") – @(Model.ClosureEnd?.ToString("dd/MM/yyyy")??"đến khi có thông báo mới")<br/>@Model.ClosureReason<br/>Phạm vi: @Model.ClosureScope</p></div>}<div class="panel"><strong>@provider.Name</strong><p class="muted">Thông tin đang công bố chỉ để tham khảo, không bảo đảm còn chỗ hoặc giá cuối cùng.</p></div></div><form asp-action="Preview" method="post" class="panel"><h2>@Model.Price.ToString("N0") ₫ <small style="font-size:13px">/ đơn vị</small></h2><input type="hidden" name="Service" value="@Model.Id"/><input type="hidden" name="Operation" value="@Guid.NewGuid()"/><partial name="_Terms" model="terms"/>@if(canReceive){@if(User.IsInRole("Traveler")){<button class="button" style="width:100%">Tiếp tục kiểm tra yêu cầu ↗</button>}else if(User.Identity?.IsAuthenticated!=true){<a class="button" href="/Account/Login?returnUrl=/Marketplace/Details/@Model.Id">Đăng nhập khách để gửi yêu cầu ↗</a>}else{<p class="notice">Chức năng gửi yêu cầu dành cho tài khoản khách du lịch.</p>}}else{<p class="notice">Không tiếp nhận yêu cầu mới. Thông tin đã duyệt vẫn được giữ để tham khảo.</p>}<p class="muted" style="margin-top:15px">Bước tiếp theo hiển thị điều kiện và cảnh báo trước khi bạn xác nhận gửi.</p></form></div></section>
