@model BookingPreviewVm
@{ViewData["Title"]="Kiểm tra trước khi gửi";var t=Model.Terms;}
<section class="section narrow"><span class="eyebrow">BƯỚC 2 · XEM LẠI ĐÚNG ĐIỀU KIỆN</span><h1>Kiểm tra yêu cầu dịch vụ</h1><article class="panel"><h2>@Model.Service.Name</h2><p>@t.Date.ToString("dd/MM/yyyy") – @(t.EndDate?.ToString("dd/MM/yyyy")??t.Date.ToString("dd/MM/yyyy")) · @t.Guests người · @t.People đơn vị</p><p>@t.ArrivalDeparture</p><p style="white-space:pre-line">Hạng mục thêm:<br/>@t.Options</p><p>Ghi chú: @t.Note</p><h3>Tổng dự kiến @t.Total.ToString("N0") ₫</h3>@foreach(var warning in Model.Warnings){<p class="notice">@warning</p>}<form asp-action="Book" method="post"><input type="hidden" name="Service" value="@t.Service"/><input type="hidden" name="Operation" value="@t.Operation"/><input type="hidden" name="Version" value="@t.Version"/><input type="hidden" name="Date" value="@t.Date.ToString("yyyy-MM-dd")"/><input type="hidden" name="EndDate" value="@t.EndDate?.ToString("yyyy-MM-dd")"/><input type="hidden" name="People" value="@t.People"/><input type="hidden" name="Guests" value="@t.Guests"/><input type="hidden" name="Total" value="@t.Total.ToString("0")"/><input type="hidden" name="Options" value="@t.Options"/><input type="hidden" name="ArrivalDeparture" value="@t.ArrivalDeparture"/><input type="hidden" name="Note" value="@t.Note"/><button class="button">Tôi đã xem cảnh báo · Xác nhận gửi</button><a class="secondary" href="/Marketplace/Details/@Model.Service.Id">Quay lại sửa / Hủy</a></form></article></section>
