@model ActivityEditor
@using TuTuc.Services
@{
    var x = Model.Input;
    var source = x.SourceType == "Manual" ? "Manual" : x.SourceType + ":" + x.SourceId;
    var dest = Model.Trip.Destination;

    // Mã các địa điểm mà một dịch vụ phục vụ (DestinationFilter.ServesPlace); JS dùng để lọc ô thứ hai.
    string PlacesOf(TravelService s) =>
        string.Join(",", Model.Places.Where(p => DestinationFilter.ServesPlace(s, p, dest)).Select(p => p.Id));

    // Khi sửa hoạt động cũ: ô địa điểm chọn sẵn đúng nơi của nguồn đang dùng.
    int? selectedPlace = null;
    if (x.SourceType == "Place")
        selectedPlace = x.SourceId;
    else if (x.SourceType == "Service" && Model.Services.FirstOrDefault(s => s.Id == x.SourceId) is { } chosen)
        selectedPlace = Model.Places
            .Where(p => DestinationFilter.ServesPlace(chosen, p, dest))
            .OrderByDescending(p => string.Equals(p.Name.Trim(), chosen.Location.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(p => (int?)p.Id).FirstOrDefault();
}

<form asp-action="Activity" method="post" class="activity-form" data-testid="activity-form-@x.Id">
    @* Mã hoạt động, kế hoạch và phiên bản được server kiểm tra lại khi POST. *@
    <input type="hidden" name="Id" value="@x.Id" />
    <input type="hidden" name="TripId" value="@Model.Trip.Id" />
    <input type="hidden" name="Version" value="@x.Version" />

    @* Hai bước: chọn địa điểm (đã lọc theo điểm đến ở JourneyManager.Detail), rồi chọn hoạt động/dịch vụ của địa điểm đó.
       Ô 1 không có name nên không gửi lên server; server chỉ nhận SourceSelection ở ô 2 như trước. *@
    <div class="form-grid">
        <label>
            1. Địa điểm tại @dest
            <select data-place-filter>
                <option value="">Chưa chọn / tự nhập</option>
                @foreach (var place in Model.Places)
                {
                    <option value="@place.Id" selected="@(selectedPlace == place.Id)">@place.Name</option>
                }
            </select>
        </label>
        <label>
            2. Hoạt động hoặc dịch vụ
            <select name="SourceSelection">
                <option value="Manual" selected="@(source == "Manual")">Tự nhập hoạt động</option>
                <optgroup label="Tham quan">
                    @foreach (var place in Model.Places)
                    {
                        <option value="Place:@place.Id" data-places="@place.Id" selected="@(source == "Place:" + place.Id)">Tham quan @place.Name</option>
                    }
                </optgroup>
                @foreach (var group in Model.Services.GroupBy(s => s.Category).OrderBy(g => g.Key))
                {
                    <optgroup label="Dịch vụ @group.Key.ToLower()">
                        @foreach (var service in group)
                        {
                            <option value="Service:@service.Id" data-places="@PlacesOf(service)" data-price="@service.Price.ToString("0")" selected="@(source == "Service:" + service.Id)">@service.Name · @service.Price.ToString("N0") đ</option>
                        }
                    </optgroup>
                }
            </select>
        </label>
    </div>
    @if (!Model.Places.Any() && !Model.Services.Any())
    {
        <small class="field-hint">Chưa có gợi ý tại @dest, hãy tự nhập hoạt động.</small>
    }

    <label>
        Nội dung hoạt động
        <input name="Title" value="@x.Title" maxlength="300"
               placeholder="Để trống nếu dùng tên địa điểm hoặc dịch vụ" />
    </label>

    <div class="form-grid">
        <label>
            Bắt đầu
            <input name="Start" type="datetime-local" value="@x.Start.ToString("yyyy-MM-ddTHH:mm")" required />
        </label>
        <label>
            Kết thúc
            <input name="End" type="datetime-local" value="@x.End.ToString("yyyy-MM-ddTHH:mm")" required />
        </label>
    </div>

    <div class="form-grid">
        <label>
            Khung giờ
            <select name="HasTime">
                <option value="true" selected="@x.HasTime">Có giờ cụ thể</option>
                <option value="false" selected="@(!x.HasTime)">Chưa xác định giờ / cả ngày</option>
            </select>
        </label>
        <label>
            Thứ tự trong ngày
            @if (x.Id == 0)
            {
                <input type="text" value="Tự xếp cuối ngày" readonly aria-describedby="activity-order-help-0" />
                
            }
            else
            {
                <input name="SortOrder" type="number" min="1" value="@Math.Max(1, x.SortOrder)" required />
                
            }
        </label>
    </div>

    <div class="form-grid">
        <label>
            Địa điểm / địa chỉ
            <input name="Location" value="@x.Location" maxlength="300" />
        </label>
        <label>
            Chi phí dự kiến (đ)
            <input name="Cost" type="number" min="0" max="1000000000"
                   value="@x.Cost.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" />
        </label>
    </div>

    <label>
        Ghi chú
        <textarea name="Notes" maxlength="1000">@x.Notes</textarea>
    </label>

    <button class="button">@(x.Id == 0 ? "Thêm vào lịch trình" : "Lưu hoạt động")</button>
</form>
