@model JourneyIncidents
@{ViewData["Title"]="Tình huống phát sinh";var draft=Model.Draft;}
<section class="workspace section"><div class="section-heading"><div><span class="eyebrow">GIỮ CHỦ ĐỘNG TRÊN HÀNH TRÌNH</span><h1>Tình huống phát sinh</h1><p class="muted">Ghi nhận vấn đề, chọn phương án và theo dõi kết quả thực tế.</p></div><a class="secondary" href="/Journey">Về chuyến đi →</a></div><div asp-validation-summary="All" class="notice"></div>
@if(!Model.Trips.Any()){<div class="empty"><h3>Cần có kế hoạch trước khi ghi nhận tình huống</h3><a class="button" href="/Journey#new-trip">Tạo kế hoạch chuyến đi</a></div>}else{<div class="incident-layout"><article class="panel"><h2>Ghi nhận tình huống</h2><form asp-action="AddIncident" method="post"><label>Chuyến đi<select name="TripId" id="incident-trip" required><option value="">Chọn chuyến đi</option>@foreach(var t in Model.Trips){<option value="@t.Id" selected="@(draft.TripId==t.Id)">@t.Name</option>}</select></label><label>Loại tình huống<select name="Category">@foreach(var c in TuTuc.Services.JourneyManager.IncidentCategories){<option selected="@(draft.Category==c)">@c</option>}</select></label><label>Mô tả<textarea name="Description" maxlength="2000" required>@draft.Description</textarea></label><label>Vị trí<input name="Location" value="@draft.Location" maxlength="300"/></label><label>Hoạt động bị ảnh hưởng (có thể chọn nhiều)<select name="ActivityIds" id="incident-activities" multiple size="5">@foreach(var t in Model.Trips){@foreach(var a in t.Activities){<option value="@a.Id" data-trip="@t.Id" selected="@draft.ActivityIds.Contains(a.Id)">@a.Start.ToString("dd/MM HH:mm") · @a.Title</option>}}</select></label><button class="button">Ghi nhận Chưa giải quyết</button></form></article><div><h2 style="margin-top:25px">Danh sách tình huống</h2><form method="get" class="toolbar"><label>Lọc chuyến đi<select name="tripId"><option value="">Tất cả chuyến đi</option>@foreach(var t in Model.Trips){<option value="@t.Id" selected="@(Model.SelectedTripId==t.Id)">@t.Name</option>}</select></label><button class="secondary">Lọc</button></form>@if(!Model.Incidents.Any()){<div class="empty">Chưa có tình huống trong danh sách này.</div>}@foreach(var i in Model.Incidents){<article class="panel"><span class="badge-status">@i.Status</span><p class="muted">@i.Category · @i.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><h3>@i.Description</h3><p>@Model.Trips.FirstOrDefault(x=>x.Id==i.TripId)?.Name</p><a class="secondary" href="/Journey/Incident/@i.Id">Xem phương án & kết quả →</a></article>}</div></div>}</section>
<style>.validation-summary-valid{display:none}.incident-layout{display:grid;grid-template-columns:1fr 1.2fr;gap:28px}@@media(max-width:800px){.incident-layout{grid-template-columns:1fr}}</style>
<script>const trip=document.getElementById('incident-trip');const activities=document.getElementById('incident-activities');if(trip&&activities){const filter=()=>{for(const option of activities.options){option.hidden=option.dataset.trip!==trip.value;option.disabled=option.hidden;if(option.hidden)option.selected=false;}};trip.addEventListener('change',filter);filter();}</script>
