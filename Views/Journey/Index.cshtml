@model List<Trip>
@{ViewData["Title"]="Chuyến đi của tôi";var draft=ViewBag.Draft as TripInput??new TripInput();}
<section class="workspace section"><div class="section-heading"><div><span class="eyebrow">CHỦ ĐỘNG TRÊN MỖI HÀNH TRÌNH</span><h1>Chuyến đi của tôi</h1><p class="muted">Lịch trình và chi phí dự kiến để bạn cân nhắc trước khi lên đường.</p></div><a class="button" href="#new-trip">+ Tạo chuyến đi</a></div><div asp-validation-summary="All" class="validation-summary-errors notice"></div>
<div class="stat-grid journey-stats"><div class="stat-card"><span>Kế hoạch của bạn</span><strong>@Model.Count</strong></div><div class="stat-card"><span>Đã chấp nhận</span><strong>@Model.Count(x=>x.Status=="Đã chấp nhận")</strong></div><div class="stat-card"><span>Hoạt động dự kiến</span><strong>@Model.Sum(x=>x.Activities.Count)</strong></div></div>
<div class="cards">@foreach(var t in Model){var total=t.Activities.Sum(x=>x.Cost??0);<article class="panel"><div class="section-heading"><span class="badge-status">@t.Status</span><span class="muted">@t.Activities.Count hoạt động</span></div><span class="eyebrow">@t.Destination</span><h2><a href="/Journey/Details/@t.Id">@t.Name</a></h2><p>@t.Start.ToString("dd/MM/yyyy") — @t.End.ToString("dd/MM/yyyy")</p><p>Dự kiến @total.ToString("N0") ₫ / Ngân sách @t.Budget.ToString("N0") ₫</p>@if(total>t.Budget){<p class="text-warning">Cảnh báo vượt ngân sách @((total-t.Budget).ToString("N0")) ₫</p>}<a class="secondary" href="/Journey/Details/@t.Id">Mở lịch trình →</a></article>}</div>
@if(!Model.Any()){<div class="empty"><h3>Chuyến đi đầu tiên đang chờ bạn</h3><p>Chọn điểm đến, ngày đi và ngân sách để bắt đầu.</p></div>}
<article class="panel" id="new-trip"><span class="eyebrow">BẮT ĐẦU MỘT KẾ HOẠCH MỚI</span><h2>Bạn muốn đến đâu?</h2><form asp-action="Save" method="post"><div class="form-grid"><label>Tên chuyến đi<input name="Name" value="@draft.Name" maxlength="150" required/></label><label>Điểm đến<input name="Destination" value="@draft.Destination" maxlength="200" required/></label><label>Ngân sách dự kiến (₫)<input name="Budget" type="number" min="0" max="1000000000" value="@draft.Budget.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label></div><div class="form-grid" style="margin-top:18px"><label>Ngày bắt đầu<input name="Start" type="date" value="@draft.Start.ToString("yyyy-MM-dd")" required/></label><label>Ngày kết thúc<input name="End" type="date" value="@draft.End.ToString("yyyy-MM-dd")" required/></label><button class="button">Tạo kế hoạch nháp ↗</button></div></form></article></section>
<style>.journey-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:25px 0}.journey-stats .stat-card{background:#edf2e5;padding:22px;border-radius:10px}.journey-stats span,.journey-stats strong{display:block}.journey-stats strong{font-size:25px;margin-top:10px}@@media(max-width:700px){.journey-stats{grid-template-columns:1fr}}</style>
