@model IncidentDetails
@{ViewData["Title"]="Chi tiết tình huống";var i=Model.Incident;var version=Convert.ToBase64String(i.Version);var closed=i.Status is "Đã giải quyết" or "Dừng xử lý";var plan=Model.DraftPlan??new IncidentPlanInput{Id=i.Id,Version=version};var result=Model.DraftResult??new IncidentResultInput{Id=i.Id,Version=version,Resolution=i.Resolution};}
<section class="section"><a class="muted" href="/Journey/Incidents?tripId=@Model.Trip.Id">← Tình huống của chuyến đi</a><div class="section-heading" style="margin-top:25px"><div><span class="eyebrow">@Model.Trip.Name · @i.Category</span><h1>@i.Description</h1><span class="badge-status">@i.Status</span></div><a class="secondary" href="/Journey/Details/@Model.Trip.Id">Mở lịch trình →</a></div><div asp-validation-summary="All" class="notice"></div><p>Vị trí: @(string.IsNullOrWhiteSpace(i.Location)?"Chưa ghi nhận":i.Location)</p><p>Hoạt động bị ảnh hưởng: @(Model.Activities.Any()?string.Join("; ",Model.Activities.Select(x=>x.Title)):"Không gắn hoạt động cụ thể")</p>
<div class="panel"><h3>Các cách xử lý có thể dùng</h3><div class="toolbar"><a class="secondary" href="/Home/Search">Tìm nơi khác</a><a class="secondary" href="/Journey/Details/@Model.Trip.Id">Điều chỉnh lịch trình</a><a class="secondary" href="/Marketplace">Đặt dịch vụ mới</a><a class="secondary" href="/Marketplace/Requests">Đổi / hủy dịch vụ</a></div></div>
<div class="cards"><article class="panel"><h2>Phương án đã chọn</h2>@if(!closed){<form asp-action="Plan" method="post"><input name="Id" type="hidden" value="@i.Id"/><input name="Version" type="hidden" value="@plan.Version"/><label>Ghi phương án mới<textarea name="Content" maxlength="1000" required>@plan.Content</textarea></label><button class="button">Lưu phương án</button></form>}<h3>Lịch sử phương án</h3>@if(!Model.Plans.Any()){<p class="muted">Chưa chọn phương án.</p>}@foreach(var p in Model.Plans){<div class="plan-history"><span class="badge-status">@(p.IsCurrent?"Hiện hành":"Phương án trước")</span><p>@p.Content</p><small>@p.ChosenAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>}</article>
<article class="panel"><h2>Kết quả thực tế</h2>@if(!closed){<form asp-action="Result" method="post"><input name="Id" type="hidden" value="@i.Id"/><input name="Version" type="hidden" value="@result.Version"/><label>Mức độ giải quyết<select name="Outcome">@foreach(var outcome in TuTuc.Services.JourneyManager.IncidentOutcomes){<option selected="@(result.Outcome==outcome)">@outcome</option>}</select></label><label>Mô tả kết quả<textarea name="Resolution" maxlength="2000">@result.Resolution</textarea></label><p class="muted">Bắt buộc mô tả khi chọn Đã giải quyết hoặc Giải quyết một phần.</p><button class="button">Lưu kết quả thực tế</button></form>}else{<p>@i.Resolution</p><p class="muted">Tình huống đã kết thúc, thông tin được giữ để đối chiếu.</p>}</article></div></section>
<style>.validation-summary-valid{display:none}.plan-history{padding:18px 0;border-bottom:1px solid #e1e6db}.toolbar{display:flex;gap:10px;flex-wrap:wrap}</style>
