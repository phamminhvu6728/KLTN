@model JourneyDetails
@{var t=Model.Trip;var version=Convert.ToBase64String(t.Version);var total=t.Activities.Sum(x=>x.Cost??0);var draft=Model.DraftTrip??new TripInput{Id=t.Id,Name=t.Name,Destination=t.Destination,Start=t.Start,End=t.End,Budget=t.Budget,Version=version};ViewData["Title"]=t.Name;}
<section class="workspace section"><a class="muted" href="/Journey">← Tất cả chuyến đi</a><div class="section-heading" style="margin-top:24px"><div><span class="eyebrow">@t.Destination · @t.Start.ToString("dd/MM") — @t.End.ToString("dd/MM/yyyy")</span><h1>@t.Name</h1><span class="badge-status">@t.Status</span></div><a class="secondary" href="/Journey/Incidents?tripId=@t.Id">Tình huống của chuyến đi →</a></div><div asp-validation-summary="All" class="notice"></div>
<div class="panel plan-summary"><div><small>NGÂN SÁCH</small><strong>@t.Budget.ToString("N0") ₫</strong></div><div><small>DỰ KIẾN HOẠT ĐỘNG</small><strong>@total.ToString("N0") ₫</strong></div><div><small>CÒN LẠI</small><strong>@((t.Budget-total).ToString("N0")) ₫</strong></div></div>
@if(Model.Warnings.Any()){<div class="notice"><strong>Cảnh báo để bạn cân nhắc</strong><ul>@foreach(var warning in Model.Warnings){<li>@warning</li>}</ul><p>Trùng giờ và vượt ngân sách không chặn lưu hoặc chấp nhận kế hoạch.</p></div>}
<div class="toolbar"><form asp-action="Confirm" method="post"><input name="id" type="hidden" value="@t.Id"/><input name="version" type="hidden" value="@version"/><button class="button">Chấp nhận kế hoạch ✓</button></form><form asp-action="Draft" method="post"><input name="id" type="hidden" value="@t.Id"/><input name="version" type="hidden" value="@version"/><button class="secondary">Lưu nháp</button></form><a class="secondary" href="/Home/Search">Chọn từ thông tin du lịch ↗</a></div><p class="muted">Kế hoạch được chấp nhận vẫn là dự kiến, không tự tạo đặt dịch vụ. Thay đổi nội dung sẽ đưa kế hoạch về Nháp.</p>
<div class="itinerary-layout"><div><div class="section-heading"><h2>Lịch trình của bạn</h2><a class="secondary" href="#add-activity">+ Thêm hoạt động</a></div>
@for(var day=t.Start.Date;day<=t.End.Date;day=day.AddDays(1)){var items=t.Activities.Where(x=>x.Start.Date==day).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Start).ToList();<h3 class="day-heading">Ngày @((day-t.Start.Date).Days+1) <small>@day.ToString("dd/MM/yyyy")</small></h3>@if(!items.Any()){<div class="empty">Chưa có hoạt động dự kiến cho ngày này.</div>}@foreach(var a in items){var input=Model.DraftActivity?.Id==a.Id?Model.DraftActivity:new ActivityInput{Id=a.Id,TripId=t.Id,Title=a.Title,Location=a.Location,Notes=a.Notes,Start=a.Start,End=a.End,Cost=a.Cost,HasTime=a.HasTime,SortOrder=Math.Max(1,a.SortOrder),Version=version,SourceType=a.PlaceId.HasValue?"Place":a.TravelServiceId.HasValue?"Service":"Manual",SourceId=a.PlaceId??a.TravelServiceId};<article class="panel activity-item"><div class="section-heading"><span class="badge-status">@(a.HasTime?a.Start.ToString("HH:mm")+" — "+a.End.ToString("HH:mm"):"Chưa xác định giờ")</span><strong>@a.Cost.ToString("N0") ₫</strong></div><h3>@a.Title</h3><p class="muted">@a.Location</p>@if(!string.IsNullOrEmpty(a.Notes)){<p>@a.Notes</p>}<details open="@(Model.DraftActivity?.Id==a.Id)"><summary>Chỉnh sửa hoạt động</summary><partial name="_ActivityForm" model="@(new ActivityEditor{Trip=t,Input=input!,Places=Model.Places,Services=Model.Services})"/></details><form asp-action="RemoveActivity" method="post" style="margin-top:16px"><input name="tripId" type="hidden" value="@t.Id"/><input name="id" type="hidden" value="@a.Id"/><input name="version" type="hidden" value="@version"/><button class="link-button">Bỏ hoạt động khỏi lịch trình</button></form></article>}}
<article class="panel" id="add-activity"><h3>+ Thêm hoạt động</h3>@{var next=Model.DraftActivity?.Id==0?Model.DraftActivity:new ActivityInput{TripId=t.Id,Version=version,Start=t.Start.AddHours(8),End=t.Start.AddHours(9),SortOrder=1};}<partial name="_ActivityForm" model="@(new ActivityEditor{Trip=t,Input=next!,Places=Model.Places,Services=Model.Services})"/></article></div>
<aside><article class="panel"><h3>Thông tin chuyến đi</h3><form asp-action="Save" method="post"><input name="Id" type="hidden" value="@t.Id"/><input name="Version" type="hidden" value="@draft.Version"/><label>Tên chuyến đi<input name="Name" value="@draft.Name" maxlength="150" required/></label><label>Điểm đến<input name="Destination" value="@draft.Destination" maxlength="200" required/></label><label>Bắt đầu<input name="Start" type="date" value="@draft.Start.ToString("yyyy-MM-dd")" required/></label><label>Kết thúc<input name="End" type="date" value="@draft.End.ToString("yyyy-MM-dd")" required/></label><label>Ngân sách (₫)<input name="Budget" type="number" min="0" max="1000000000" value="@draft.Budget.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label><button class="secondary">Lưu thông tin</button></form></article><article class="panel"><h3>Theo dõi hành trình</h3><p>@Model.Incidents.Count tình huống đã ghi nhận</p><a class="secondary" href="/Journey/Incidents?tripId=@t.Id">Ghi nhận tình huống →</a><a class="secondary" href="/Marketplace">Tìm dịch vụ →</a></article></aside></div></section>
<style>.validation-summary-valid{display:none}.plan-summary{display:flex;justify-content:space-between;gap:20px}.plan-summary small{display:block;color:#7a8775;font-size:10px}.plan-summary strong{display:block;font-size:24px;margin-top:8px}.toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:20px 0}.itinerary-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:28px;margin-top:30px}.itinerary-layout .form-grid{grid-template-columns:1fr 1fr;margin-bottom:15px}.activity-form{padding-top:20px}.day-heading{font-size:21px;margin:30px 0 15px}.day-heading small{font-size:12px;margin-left:12px}.activity-item{border-left:4px solid #adc58d}@@media(max-width:900px){.itinerary-layout{grid-template-columns:1fr}.plan-summary{flex-wrap:wrap}}@@media(max-width:560px){.itinerary-layout .form-grid{grid-template-columns:1fr}}</style>
