@model JourneyDetails
@using TuTuc.Services
@{
 var trip=Model.Trip;var version=Convert.ToBase64String(trip.Version);var total=trip.Activities.Sum(a=>a.Cost??0);
 var draft=Model.DraftTrip??new TripInput{Id=trip.Id,Name=trip.Name,Destination=trip.Destination,Start=trip.Start,End=trip.End,Budget=trip.Budget,Version=version};
 var dayCount=Math.Max(1,(trip.End.Date-trip.Start.Date).Days+1);var percentage=trip.Budget>0?Math.Min(100,total/trip.Budget.Value*100):trip.Budget.HasValue&&total>0?100:0;
 ViewData["Title"]=trip.Name;
}
<section class="section itinerary-page" data-testid="trip-details" data-trip-id="@trip.Id">
 <div class="breadcrumb-line"><a href="/Journey">Kế hoạch của tôi</a><span>/</span><span>Chi tiết #@trip.Id</span><button type="button" class="text-link print-action" onclick="window.print()">In kế hoạch <partial name="_TravelIcon" model='@("note")'/></button></div>
 <div class="trip-cover"><div><span class="eyebrow">LỊCH TRÌNH CHUYẾN ĐI</span><h1>@trip.Name</h1><p class="trip-cover-meta"><span><partial name="_TravelIcon" model='@("pin")'/>@trip.Destination</span><span><partial name="_TravelIcon" model='@("calendar")'/>@trip.Start.ToString("dd/MM") – @trip.End.ToString("dd/MM/yyyy")</span><span>@dayCount ngày</span></p><span class="badge-status @(trip.Status=="Đã chấp nhận"?"status-confirmed":"status-draft")" data-testid="trip-status">@trip.Status</span></div><div class="trip-cover-image"><img src="@TravelPresentation.Cover(trip.Destination)" alt="Ảnh minh họa điểm đến @trip.Destination"/><span>@trip.Destination</span></div></div>
 <div asp-validation-summary="All" role="alert"></div>
 <div class="trip-workspace-bar"><nav class="day-navigation" aria-label="Chuyển đến ngày trong chuyến đi">@for(var i=Model.DayOffset;i<Math.Min(dayCount,Model.DayOffset+31);i++){<a class="@(i==Model.DayOffset?"first-day":"")" href="#day-@(i+1)">Ngày @(i+1)<small>@trip.Start.AddDays(i).ToString("dd/MM")</small></a>}</nav><a class="text-link" href="#add-activity"><partial name="_TravelIcon" model='@("plus")'/>Thêm hoạt động</a></div>
 <div class="itinerary-layout"><div class="itinerary-days">
 @if(Model.Warnings.Any()){<div class="notice itinerary-warning" data-testid="trip-warnings"><partial name="_TravelIcon" model='@("alert")'/><div><strong>Có @Model.Warnings.Count điểm cần cân nhắc</strong><ul>@foreach(var warning in Model.Warnings){<li>@warning</li>}</ul><p>Trùng giờ và vượt ngân sách không chặn lưu hoặc chấp nhận kế hoạch.</p></div></div>}
 @for(var offset=Model.DayOffset;offset<=Math.Min((trip.End.Date-trip.Start.Date).Days,Model.DayOffset+30);offset++){
   var day=trip.Start.Date.AddDays(offset);
   var activities=trip.Activities.Where(a=>a.Start.Date==day).OrderBy(a=>a.SortOrder).ThenBy(a=>a.Start).ThenBy(a=>a.Id).ToList();
   <section class="itinerary-day" id="day-@(offset+1)"><div class="day-heading"><span class="day-number">@((offset+1).ToString("00"))</span><div><h2>Ngày @(offset+1)<small>@day.ToString("dd/MM/yyyy")</small></h2><p>@activities.Count hoạt động <span>·</span> @activities.Sum(a=>a.Cost??0).ToString("N0") đ dự kiến</p></div></div>
   @if(!activities.Any()){<div class="day-empty"><span class="timeline-node"></span><p>Ngày này còn để trống.<br/><a href="#add-activity" data-activity-day="@day.ToString("yyyy-MM-dd")">Thêm một hoạt động cho ngày @day.ToString("dd/MM") →</a></p></div>}
   @foreach(var activity in activities){
    var input=Model.DraftActivity?.Id==activity.Id?Model.DraftActivity:new ActivityInput{Id=activity.Id,TripId=trip.Id,Title=activity.Title,Location=activity.Location,Notes=activity.Notes,Start=activity.Start,End=activity.End,Cost=activity.Cost,HasTime=activity.HasTime,SortOrder=Math.Max(1,activity.SortOrder),Version=version,SourceType=activity.PlaceId.HasValue?"Place":activity.TravelServiceId.HasValue?"Service":"Manual",SourceId=activity.PlaceId??activity.TravelServiceId};
    <article class="panel activity-item" data-testid="activity-@activity.Id"><span class="timeline-node"></span><div class="activity-time"><partial name="_TravelIcon" model='@("clock")'/>@(activity.HasTime?activity.Start.ToString("HH:mm")+" – "+activity.End.ToString("HH:mm"):"Chưa xác định giờ")<span class="activity-source">@(activity.TravelServiceId.HasValue?"Dịch vụ tham khảo":activity.PlaceId.HasValue?"Điểm đến tham khảo":"Tự lên lịch")</span></div><h3>@activity.Title</h3>@if(!string.IsNullOrWhiteSpace(activity.Location)){<p class="activity-location"><partial name="_TravelIcon" model='@("pin")'/>@activity.Location</p>}@if(!string.IsNullOrWhiteSpace(activity.Notes)){<p class="activity-note">@activity.Notes</p>}<div class="activity-bottom"><strong>@(activity.Cost.HasValue?activity.Cost.Value.ToString("N0")+" đ":"Chưa dự kiến") <small>/ dự kiến</small></strong>@if(activity.TravelServiceId.HasValue){<a class="text-link" href="/Marketplace/Details/@activity.TravelServiceId?date=@activity.Start.ToString("yyyy-MM-dd")">Xem dịch vụ và gửi yêu cầu riêng <partial name="_TravelIcon" model='@("arrow")'/></a>}</div>
     <details open="@(Model.DraftActivity?.Id==activity.Id)"><summary>Chỉnh sửa hoạt động</summary><partial name="ActivityFields" model="@(new ActivityEditor{Trip=trip,Input=input!,Places=Model.Places,Services=Model.Services})"/></details>
     <form asp-action="RemoveActivity" method="post" data-testid="activity-remove-@activity.Id"><input name="tripId" type="hidden" value="@trip.Id"/><input name="id" type="hidden" value="@activity.Id"/><input name="version" type="hidden" value="@version"/><button class="link-button danger-action">Bỏ hoạt động khỏi lịch trình</button></form>
    </article>
   }</section>
 }
 @if(dayCount>31){<div class="toolbar">@if(Model.DayOffset>0){<a class="secondary" href="/Journey/Details/@trip.Id?dayPage=@(Model.DayOffset/31)">← Các ngày trước</a>}<span class="muted">Ngày @(Model.DayOffset+1)–@Math.Min(dayCount,Model.DayOffset+31) / @dayCount</span>@if(Model.DayOffset+31<dayCount){<a class="secondary" href="/Journey/Details/@trip.Id?dayPage=@(Model.DayOffset/31+2)">Các ngày tiếp →</a>}</div>}
 <article class="panel activity-add-panel" id="add-activity"><div class="form-section-head"><span class="number-mark">+</span><div><span class="eyebrow">THÊM VÀO CHUYẾN ĐI</span><h2>Thêm hoạt động</h2></div></div><p class="muted">Chọn từ thông tin tham khảo hoặc tự ghi lại điều bạn muốn làm.</p>
 @{var next=Model.DraftActivity?.Id==0?Model.DraftActivity:new ActivityInput{TripId=trip.Id,Version=version,Start=trip.Start.AddHours(8),End=trip.Start.AddHours(9),SortOrder=1};}
 <partial name="ActivityFields" model="@(new ActivityEditor{Trip=trip,Input=next!,Places=Model.Places,Services=Model.Services})"/></article>
 </div><aside class="journey-summary">
 <article class="panel budget-paper"><span class="eyebrow">CHI PHÍ CHUYẾN ĐI</span><h2>Ngân sách dự kiến</h2><span class="budget-caption">Tổng các hoạt động</span><strong class="budget-amount" data-testid="trip-total">@total.ToString("N0") đ</strong><div class="budget-track @(total>trip.Budget?"over-budget":"")"><span style="width:@percentage.ToString("0",System.Globalization.CultureInfo.InvariantCulture)%"></span></div><dl class="budget-breakdown"><div><dt>Ngân sách</dt><dd>@(trip.Budget.HasValue?trip.Budget.Value.ToString("N0")+" đ":"Chưa xác định")</dd></div><div class="@(total>trip.Budget?"amount-warning":"")"><dt>@(total>trip.Budget?"Vượt dự kiến":"Còn lại")</dt><dd>@(trip.Budget.HasValue?Math.Abs(trip.Budget.Value-total).ToString("N0")+" đ":"—")</dd></div></dl><div class="plan-actions">
 <form asp-action="Confirm" method="post" data-testid="trip-confirm-form"><input name="id" type="hidden" value="@trip.Id"/><input name="version" type="hidden" value="@version"/><button class="button full-width"><partial name="_TravelIcon" model='@("check")'/>Chấp nhận kế hoạch</button></form><form asp-action="Draft" method="post"><input name="id" type="hidden" value="@trip.Id"/><input name="version" type="hidden" value="@version"/><button class="secondary full-width">Lưu nháp</button></form></div><p class="field-hint">Kế hoạch là dự kiến, chưa phải đặt dịch vụ. Sửa nội dung sẽ đưa kế hoạch về Nháp.</p></article>
 <article class="panel trip-settings"><details open="@(Model.DraftTrip!=null)"><summary>Thông tin kế hoạch</summary><form asp-action="Save" method="post" data-testid="trip-edit-form"><input name="Id" type="hidden" value="@trip.Id"/><input name="Version" type="hidden" value="@draft.Version"/><label>Tên chuyến đi<input name="Name" value="@draft.Name" maxlength="150" required/></label><label>Điểm đến<input name="Destination" value="@draft.Destination" maxlength="200" list="destination-options" required/>@await Component.InvokeAsync("DestinationOptions")</label><label>Bắt đầu<input name="Start" type="date" value="@draft.Start.ToString("yyyy-MM-dd")" required/></label><label>Kết thúc<input name="End" type="date" value="@draft.End.ToString("yyyy-MM-dd")" required/></label><label>Ngân sách (đ)<input name="Budget" type="number" min="0" max="1000000000" value="@draft.Budget.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label><button class="secondary full-width">Lưu thông tin</button></form></details></article>
 <div class="journey-related"><a href="/Home/Search"><partial name="_TravelIcon" model='@("search")'/>Chọn từ tra cứu <span>→</span></a><a href="/Marketplace"><partial name="_TravelIcon" model='@("bag")'/>Tìm dịch vụ <span>→</span></a><a href="/Journey/Incidents?tripId=@trip.Id"><partial name="_TravelIcon" model='@("alert")'/>Tình huống của chuyến đi (@Model.Incidents.Count)<span>→</span></a></div>
 </aside></div>
</section>
