@model ActivityEditor
@{var x=Model.Input;var source=x.SourceType=="Manual"?"Manual":x.SourceType+":"+x.SourceId;}
<form asp-action="Activity" method="post" class="activity-form"><input type="hidden" name="Id" value="@x.Id"/><input type="hidden" name="TripId" value="@Model.Trip.Id"/><input type="hidden" name="Version" value="@x.Version"/>
<label>Chọn mục tham khảo hoặc tự nhập<select name="SourceSelection"><option value="Manual" selected="@(source=="Manual")">Tự nhập hoạt động</option><optgroup label="Địa điểm">@foreach(var p in Model.Places){<option value="Place:@p.Id" selected="@(source=="Place:"+p.Id)">@p.Name</option>}</optgroup><optgroup label="Dịch vụ đã công bố">@foreach(var s in Model.Services){<option value="Service:@s.Id" selected="@(source=="Service:"+s.Id)">@s.Name</option>}</optgroup></select></label>
<label>Nội dung hoạt động<input name="Title" value="@x.Title" maxlength="300" placeholder="Để trống để dùng tên mục đã chọn"/></label><div class="form-grid"><label>Bắt đầu<input name="Start" type="datetime-local" value="@x.Start.ToString("yyyy-MM-ddTHH:mm")" required/></label><label>Kết thúc<input name="End" type="datetime-local" value="@x.End.ToString("yyyy-MM-ddTHH:mm")" required/></label></div><div class="form-grid"><label>Khung giờ<select name="HasTime"><option value="true" selected="@x.HasTime">Có giờ cụ thể</option><option value="false" selected="@(!x.HasTime)">Chưa xác định giờ / cả ngày</option></select></label><label>Thứ tự trong ngày<input name="SortOrder" type="number" min="1" value="@Math.Max(1,x.SortOrder)" required/></label></div><div class="form-grid"><label>Địa điểm / địa chỉ<input name="Location" value="@x.Location" maxlength="300"/></label><label>Chi phí dự kiến (₫)<input name="Cost" type="number" min="0" max="1000000000" value="@x.Cost.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label></div><label>Ghi chú<textarea name="Notes" maxlength="1000">@x.Notes</textarea></label><button class="button">@(x.Id==0?"Thêm vào lịch trình":"Lưu hoạt động")</button></form>
