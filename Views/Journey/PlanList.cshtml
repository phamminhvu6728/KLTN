@model List<Trip>
@using TuTuc.Services
@{ViewData["Title"]="Kế hoạch chuyến đi";var draft=ViewBag.Draft as TripInput??new TripInput();}
<section class="section plans-page">
 <div class="page-heading"><div><span class="eyebrow">KẾ HOẠCH CHUYẾN ĐI</span><h1>Kế hoạch của tôi</h1><p class="muted">Quản lý thời gian, hoạt động và ngân sách của từng chuyến đi.</p></div><a href="#new-trip" class="button"><partial name="_TravelIcon" model='@("plus")'/>Tạo kế hoạch</a></div>
 <div class="notebook-meta"><span><strong>@Model.Count</strong> kế hoạch đã lưu</span><span><i class="status-dot"></i>@Model.Count(x=>x.Status=="Đã chấp nhận") đã chấp nhận</span><span>@Model.Count(x=>x.Status=="Nháp") bản nháp</span></div>
 <div asp-validation-summary="All" role="alert"></div>
 @if((ViewBag.TotalCount as int? ?? 0)>20){var currentPage=ViewBag.Page as int? ?? 1;var count=(int)ViewBag.TotalCount;<nav class="toolbar" aria-label="Phân trang kế hoạch">@if(currentPage>1){<a class="secondary" href="?trang=@(currentPage-1)">← Trang trước</a>}<span class="muted">Trang @(currentPage) / @((count+19)/20)</span>@if((long)currentPage*20<count){<a class="secondary" href="?trang=@(currentPage+1)">Trang sau →</a>}</nav>}
<div class="planning-columns"><div class="trip-library" data-testid="trip-list">
 @foreach(var trip in Model){var total=trip.Activities.Sum(a=>a.Cost??0);var days=(trip.End.Date-trip.Start.Date).Days+1;var ratio=trip.Budget>0?Math.Min(100,total/trip.Budget.Value*100):trip.Budget.HasValue&&total>0?100:0;
 <article class="trip-journal" data-trip-id="@trip.Id"><a class="trip-journal-photo" href="/Journey/Details/@trip.Id" tabindex="-1" aria-hidden="true"><img src="@TravelPresentation.Cover(trip.Destination)" alt="" loading="lazy"/><span>@days ngày</span></a><div class="trip-journal-content"><div class="trip-card-top"><span class="location-text"><partial name="_TravelIcon" model='@("pin")'/>@trip.Destination</span><span class="badge-status @(trip.Status=="Đã chấp nhận"?"status-confirmed":"status-draft")">@trip.Status</span></div><h2><a href="/Journey/Details/@trip.Id">@trip.Name</a></h2><div class="trip-card-date"><partial name="_TravelIcon" model='@("calendar")'/>@trip.Start.ToString("dd/MM") – @trip.End.ToString("dd/MM/yyyy")<span>·</span>@trip.Activities.Count hoạt động</div><div class="trip-budget-line"><span><strong>@total.ToString("N0") đ</strong> dự kiến</span><small>Ngân sách @(trip.Budget.HasValue?trip.Budget.Value.ToString("N0")+" đ":"Chưa xác định")</small></div><div class="budget-track @(total>trip.Budget?"over-budget":"")"><span style="width:@ratio.ToString("0",System.Globalization.CultureInfo.InvariantCulture)%"></span></div><a class="trip-open" href="/Journey/Details/@trip.Id">Mở lịch trình <partial name="_TravelIcon" model='@("arrow")'/></a></div></article>
 }
 @if(!Model.Any()){<div class="empty empty-journal"><partial name="_TravelIcon" model='@("map")'/><h2>Chưa có kế hoạch chuyến đi</h2><p>Bắt đầu với một điểm đến và khoảng thời gian.<br/>Bạn có thể thêm hoạt động và điều chỉnh sau.</p><a href="#new-trip" class="text-link">Tạo kế hoạch đầu tiên →</a></div>}
 </div><aside class="new-plan-aside"><article id="new-trip" class="panel new-plan-panel"><div class="form-section-head"><span class="number-mark">+</span><div><span class="eyebrow">THÔNG TIN CHUYẾN ĐI</span><h2>Tạo kế hoạch mới</h2></div></div>
 <form asp-action="Save" method="post" data-testid="trip-create-form"><label>Tên chuyến đi<input name="Name" value="@draft.Name" maxlength="150" placeholder="Ví dụ: Ba ngày ở Đà Lạt" required/></label><label>Điểm đến<input name="Destination" value="@draft.Destination" maxlength="200" placeholder="Bạn muốn đi đâu?" list="destination-options" required/>@await Component.InvokeAsync("DestinationOptions")</label><div class="form-grid"><label>Ngày bắt đầu<input name="Start" type="date" value="@draft.Start.ToString("yyyy-MM-dd")" required/></label><label>Ngày kết thúc<input name="End" type="date" value="@draft.End.ToString("yyyy-MM-dd")" required/></label></div><label class="spaced-field">Ngân sách dự kiến (đ)<input name="Budget" type="number" min="0" max="1000000000" value="@draft.Budget.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label><p class="field-hint">Nhập số nguyên, không có dấu phân cách. Bạn có thể điều chỉnh ngân sách sau.</p><button class="button full-width">Tạo kế hoạch nháp <partial name="_TravelIcon" model='@("arrow")'/></button></form><p class="form-bottom-note"><partial name="_TravelIcon" model='@("note")'/>Lưu nháp trước, hoàn thiện lịch trình sau. Lịch trình dài được chia trang theo từng nhóm ngày.</p></article></aside></div>
</section>
