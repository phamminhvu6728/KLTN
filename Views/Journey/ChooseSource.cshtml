@model List<Trip>
@{ViewData["Title"]="Chọn chuyến đi";}
<section class="section"><span class="eyebrow">THÊM CẢM HỨNG VÀO HÀNH TRÌNH</span><h1>Chọn kế hoạch muốn thêm vào</h1><p class="muted">Chọn chuyến đi, sau đó kiểm tra ngày, giờ và chi phí trước khi lưu hoạt động.</p><div class="cards">@foreach(var trip in Model){<article class="panel"><h2>@trip.Name</h2><p>@trip.Start.ToString("dd/MM/yyyy") — @trip.End.ToString("dd/MM/yyyy")</p><a class="button" asp-action="Details" asp-route-id="@trip.Id" asp-route-sourceType="@ViewBag.SourceType" asp-route-sourceId="@ViewBag.SourceId">Chọn chuyến đi này →</a></article>}</div>@if(!Model.Any()){<div class="empty">Bạn chưa có kế hoạch. <a class="button" href="/Journey#new-trip">Tạo kế hoạch trước</a></div>}</section>
