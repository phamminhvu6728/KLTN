@model List<Trip>
@{ViewData["Title"]="Chọn chuyến đi";}
@* Danh sách đã được JourneyManager.TripsForSource lọc: chỉ còn các kế hoạch cùng điểm đến với mục đang thêm. *@
<section class="section"><span class="eyebrow">THÊM VÀO HÀNH TRÌNH</span><h1>Thêm "@ViewBag.SourceName" vào kế hoạch</h1><p class="muted">Chỉ hiện các kế hoạch có điểm đến phù hợp với mục này. Chọn chuyến đi, sau đó kiểm tra ngày, giờ và chi phí trước khi lưu.</p><div class="cards">@foreach(var trip in Model){<article class="panel"><h2>@trip.Name</h2><p>@trip.Destination · @trip.Start.ToString("dd/MM/yyyy") — @trip.End.ToString("dd/MM/yyyy")</p><a class="button" asp-action="Details" asp-route-id="@trip.Id" asp-route-sourceType="@ViewBag.SourceType" asp-route-sourceId="@ViewBag.SourceId">Chọn chuyến đi này →</a></article>}</div>@if(!Model.Any()){<div class="empty">Bạn chưa có kế hoạch nào đến nơi có "@ViewBag.SourceName". <a class="button" href="/Journey#new-trip">Tạo kế hoạch mới</a></div>}</section>
