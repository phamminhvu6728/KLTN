@model TravelSearchVm
@{ViewData["Title"]="Tra cứu thông tin du lịch";}
<section class="section"><div class="page-heading"><div><span class="eyebrow">ĐIỂM ĐẾN VÀ DỊCH VỤ</span><h1>Tìm điều bạn cần cho chuyến đi</h1><p class="muted">Điểm đến, lưu trú, ăn uống, di chuyển và trải nghiệm từ dữ liệu đã công bố.</p></div><a class="secondary" href="/">← Khám phá</a></div><form method="get" class="panel search-filter-panel"><div asp-validation-summary="All" class="validation-error"></div><div class="form-grid"><label>Từ khóa<input name="Keyword" value="@Model.Input.Keyword" placeholder="Điểm đến, homestay, hoạt động…" maxlength="100"/></label><label>Khu vực<input name="Region" value="@Model.Input.Region" maxlength="100" placeholder="Tỉnh, thành hoặc nơi đến"/></label><label>Loại thông tin<select name="Type"><option value="">Tất cả</option>@foreach(var t in new[]{"Địa điểm","Lưu trú","Ăn uống","Di chuyển","Trải nghiệm"}){<option value="@t" selected="@(Model.Input.Type==t)">@t</option>}</select></label></div><div class="form-grid" style="margin-top:18px"><label>Giá từ (₫)<input type="number" name="MinPrice" min="0" value="@Model.Input.MinPrice"/></label><label>Giá đến (₫)<input type="number" name="MaxPrice" min="0" value="@Model.Input.MaxPrice"/></label><label>Sắp xếp<select name="Sort"><option value="name" selected="@(Model.Input.Sort=="name")">Tên A–Z</option><option value="price-asc" selected="@(Model.Input.Sort=="price-asc")">Giá tăng dần</option><option value="price-desc" selected="@(Model.Input.Sort=="price-desc")">Giá giảm dần</option></select></label><button class="button">Tra cứu thông tin ⌕</button></div></form><p class="muted">Giá chỉ mang tính tham khảo; thông tin công bố không bảo đảm còn chỗ hoặc giá cuối cùng.</p>@if(ViewData.ModelState.IsValid){<p>@Model.Items.Count kết quả phù hợp</p><div class="cards search-results">@foreach(var item in Model.Items){<article class="panel"><img class="search-result-image" src="@(string.IsNullOrEmpty(item.Image)?TuTuc.Services.TravelPresentation.Cover(item.Region):item.Image)" alt="Ảnh minh họa @item.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/dalat.jpg'"/><span class="eyebrow">@item.Region · @item.Category</span><h2>@item.Name</h2><p>@(item.Description.Length>240?item.Description[..240]+"…":item.Description)</p><p><strong>@item.Price.ToString("N0") ₫</strong></p><p class="badge-status">@item.State</p><div class="place-actions"><a class="button" href="@item.Url">Xem chi tiết ↗</a><a class="secondary" href="/Journey/ChooseSource?sourceType=@item.SourceType&sourceId=@item.Id">Thêm vào lịch trình</a></div></article>}</div>@if(!Model.Items.Any()){<div class="empty"><h3>Chưa tìm thấy thông tin phù hợp</h3><p>Thử mở rộng khu vực hoặc khoảng giá.</p><a class="secondary" href="/Home/Search">Xóa bộ lọc</a></div>}}</section>
