@model List<Place>
@{ViewData["Title"]="Khám phá Việt Nam";}
<section class="hero"><div class="hero-content"><span class="eyebrow light">VIỆT NAM ĐANG CHỜ BẠN</span><h1>Đi theo cách<br/>của <em>riêng bạn.</em></h1><p>Tìm một nơi mới. Gặp người đồng điệu.<br/>Tự tay viết nên hành trình đáng nhớ.</p><a class="button" href="/Journey#new-trip">Lên kế hoạch chuyến đi ↗</a><div class="hero-note">↳ Từ những ý tưởng nhỏ, đến những hành trình lớn.</div></div><div class="photo-caption">01 / KHÁM PHÁ VIỆT NAM<br/><strong>Những miền xanh, những điều mới.</strong></div></section>
<section class="search-wrap"><form method="get" action="/Home/Search" class="searchbar"><label><small>BẠN MUỐN ĐI ĐÂU?</small><input name="Keyword" value="@ViewBag.Query" placeholder="Tên điểm đến hoặc tỉnh thành"/></label><label><small>TRẢI NGHIỆM YÊU THÍCH</small><select name="Type"><option value="">Tất cả thông tin</option><option>Địa điểm</option><option>Lưu trú</option><option>Ăn uống</option><option>Di chuyển</option><option>Trải nghiệm</option></select></label><button class="button">Tìm điểm đến ⌕</button></form></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">MỘT CHÚT CẢM HỨNG CHO BẠN</span><h2>Đi đâu cho lần tiếp theo?</h2></div><a href="/Home/Search">Tra cứu tất cả thông tin ↗</a></div><div class="chips"><a href="/">Tất cả</a><a href="/?category=Núi rừng">♧ Núi rừng</a><a href="/?category=Biển đảo">≈ Biển đảo</a><a href="/?category=Văn hóa">⌂ Văn hóa</a><a href="/?category=Thiên nhiên">☀ Thiên nhiên</a></div><div class="destinations">@foreach(var p in Model){<div class="destination-wrap"><a class="destination" href="/Home/Place/@p.Id"><div class="destination-img" style="background-image:url('@p.Image')"><span>@p.Category</span><b>↗</b></div><div class="place-meta">@p.Region <span>VIỆT NAM</span></div><h3>@p.Name</h3><p>Từ @p.Price.ToString("N0") ₫ <small>/ ngân sách gợi ý</small></p></a></div>}</div>@if(Model.Count==0){<p class="empty">Chưa có điểm đến phù hợp. <a href="/">Xóa bộ lọc và khám phá lại →</a></p>}</section>
<section class="journey"><div><span class="eyebrow">BẠN ĐI TỰ TÚC. BẠN KHÔNG ĐƠN ĐỘC.</span><h2>Một hành trình hay hơn,<br/>khi có người cùng chia sẻ.</h2><p>Kết nối những người chung điểm đến và sở thích.<br/>Chủ động trao đổi trước khi bắt đầu chuyến đi.</p><a class="button" href="/Community">Tìm bạn đồng hành ↗</a></div><div class="journey-art"><span>ĐI CÙNG NHAU</span><strong>Những người lạ.<br/>Những kỷ niệm quen.</strong><div class="avatars">🌿 ⛰ ☀</div></div></section>
<section class="steps section"><div><b>01</b><h3>Khám phá điều mới</h3><p>Tra cứu điểm đến và chọn trải nghiệm cho chuyến đi.</p></div><div><b>02</b><h3>Sắp xếp hành trình</h3><p>Chủ động thời gian, hoạt động và ngân sách của bạn.</p></div><div><b>03</b><h3>Sẵn sàng lên đường</h3><p>Kết nối đồng hành và trao đổi trực tiếp với nhà cung cấp.</p></div></section><section class="service-callout"><div><span class="eyebrow">TRẢI NGHIỆM ĐỊA PHƯƠNG</span><h3>Những người hiểu điểm đến nhất, luôn ở đây.</h3><p>Tìm chỗ ở, hướng dẫn viên và các hoạt động dành cho hành trình của bạn.</p></div><a class="button" href="/Marketplace">Khám phá dịch vụ ↗</a></section>

