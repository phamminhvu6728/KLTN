@model List<Place>
@{ViewData["Title"]="Bắt đầu chuyến đi";}
<section class="guest-home">
 <div class="guest-hero">
  <div class="guest-hero-copy"><span class="eyebrow">ĐI TỰ TÚC, CÓ CHUẨN BỊ</span><h1>Chọn nơi muốn đến.<br/><em>Tự xếp chuyến đi.</em></h1><p>Tra cứu thông tin địa phương, gom hoạt động vào một lịch trình và giữ mọi thứ trong tầm tay.</p><div class="guest-hero-actions"><a class="button" href="/Account/Login">Bắt đầu lập kế hoạch <span>→</span></a><a class="guest-text-link" href="#destinations">Xem điểm đến <span>↓</span></a></div></div>
  <div class="guest-hero-note"><span>GỢI Ý CHO NGƯỜI MỚI</span><strong>Đà Lạt</strong><small>3 ngày · núi rừng · từ 1.000.000 đ</small></div>
 </div>
 <div class="guest-search-card"><div class="guest-search-title"><span class="search-mark">⌕</span><div><strong>Tìm thông tin cho chuyến đi</strong><small>Điểm đến, nơi ở, ăn uống hoặc trải nghiệm</small></div></div><form action="/Home/Search" method="get"><input name="Keyword" placeholder="Ví dụ: Đà Lạt, homestay, thuê xe…"/><select name="Type" aria-label="Loại thông tin"><option value="">Tất cả thông tin</option><option>Địa điểm</option><option>Lưu trú</option><option>Ăn uống</option><option>Di chuyển</option><option>Trải nghiệm</option></select><button class="button">Tra cứu <span>→</span></button></form></div>
 <section class="guest-section guest-categories"><div class="guest-section-head"><div><span class="eyebrow">BẮT ĐẦU TỪ ĐIỀU BẠN CẦN</span><h2>Khám phá theo cách của bạn</h2></div><a class="guest-text-link" href="/Home/Search">Mở tra cứu nâng cao →</a></div><div class="guest-category-grid"><a href="/Home/Search?Type=Địa điểm"><span class="category-icon category-land">⌂</span><strong>Điểm đến</strong><small>Nơi nên ghé</small></a><a href="/Home/Search?Type=Lưu trú"><span class="category-icon category-stay">▣</span><strong>Lưu trú</strong><small>Chỗ ở tham khảo</small></a><a href="/Home/Search?Type=Ăn uống"><span class="category-icon category-food">◒</span><strong>Ăn uống</strong><small>Món địa phương</small></a><a href="/Home/Search?Type=Di chuyển"><span class="category-icon category-move">↗</span><strong>Di chuyển</strong><small>Cách đi thuận tiện</small></a><a href="/Home/Search?Type=Trải nghiệm"><span class="category-icon category-do">✦</span><strong>Trải nghiệm</strong><small>Việc đáng thử</small></a></div></section>
 <section class="guest-section" id="destinations"><div class="guest-section-head"><div><span class="eyebrow">ĐIỂM ĐẾN ĐƯỢC QUAN TÂM</span><h2>Chọn một nơi để bắt đầu</h2></div><a class="guest-text-link" href="/Home/Search">Xem tất cả →</a></div><div class="guest-destination-grid">@foreach(var place in Model){<a class="guest-destination" href="/Home/Place/@place.Id"><div class="guest-destination-image"><img src="@place.Image" alt="Ảnh minh họa @place.Name" loading="lazy"/><span>@place.Category</span><b>↗</b></div><div class="guest-destination-meta"><small>@place.Region</small><small>NGÂN SÁCH GỢI Ý</small></div><h3>@place.Name</h3><p>Từ @place.Price.ToString("N0") đ / chuyến</p></a>}</div></section>
 <section class="guest-choices"><a href="/Journey" class="guest-choice guest-choice-plan"><span class="eyebrow">DÀNH CHO CHUYẾN ĐI CỦA BẠN</span><h2>Lịch trình rõ ràng,<br/>đi chơi nhẹ đầu.</h2><p>Lưu điểm đến, thêm hoạt động và theo dõi ngân sách ở một chỗ.</p><strong>Đăng nhập để lập kế hoạch →</strong></a><a href="/Community" class="guest-choice guest-choice-companion"><span class="eyebrow">KHÔNG CẦN ĐI MỘT MÌNH</span><h2>Tìm người cùng<br/>chung nhịp đi.</h2><p>Trao đổi trước chuyến đi với người có cùng nơi đến và sở thích.</p><strong>Tìm bạn đồng hành →</strong></a></section>
 <div class="guest-footnote"><span>đi · TỰ TÚC · TỰ DO</span><p>Thông tin mang tính tham khảo. Bạn luôn là người quyết định hành trình của mình.</p></div>
</section>
