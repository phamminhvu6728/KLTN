@model List<Place>
@{ViewData["Title"]="Bắt đầu chuyến đi";}
<section class="section guest-workspace"><div class="workspace-heading"><div><div class="workspace-breadcrumb">Hỗ trợ khách du lịch tự túc</div><h1>Lập kế hoạch chuyến đi</h1><p>Tra cứu thông tin trước khi đi. Đăng nhập để lưu lịch trình và quản lý yêu cầu dịch vụ.</p></div><a class="button" href="/Account/Login">Đăng nhập để lập kế hoạch →</a></div><form action="/Home/Search" method="get" class="panel form-grid"><label>Điểm đến hoặc dịch vụ<input name="Keyword" placeholder="Nhập từ khóa tra cứu"/></label><label>Loại thông tin<select name="Type"><option value="">Tất cả</option><option>Địa điểm</option><option>Lưu trú</option><option>Ăn uống</option><option>Di chuyển</option><option>Trải nghiệm</option></select></label><button class="button">Tra cứu</button></form><div class="section-heading"><h2>Điểm đến tham khảo</h2><a class="text-link" href="/Home/Search">Xem tất cả →</a></div><div class="destination-grid">@foreach(var place in Model){<a class="destination-tile" href="/Home/Place/@place.Id"><div class="destination-image"><img src="@place.Image" alt="Ảnh minh họa @place.Name" loading="lazy"/></div><div class="destination-caption"><div><small>@place.Region · @place.Category</small><h3>@place.Name</h3></div><partial name="_TravelIcon" model='@("arrow")'/></div><p>Ngân sách gợi ý @place.Price.ToString("N0") đ</p></a>}</div></section>
