@model ReferenceLibraryViewModel
@{ViewData["Title"]="Thông tin đã lưu";}
<section class="section workspace"><div class="page-heading"><div><span class="eyebrow">GIỮ LẠI CẢM HỨNG</span><h1>Thông tin tham khảo</h1><p class="muted">Chọn điểm đến để so sánh, rồi lưu thành danh sách riêng khi đã sẵn sàng.</p></div><a class="button" href="/">+ Khám phá điểm đến</a></div><h2>Tập tham khảo tạm <span class="badge-status">@Model.Temporary.Count điểm đến</span></h2><p class="muted">Tập tạm được giữ trong phiên trình duyệt. Chỉ thao tác “Lưu danh sách” mới ghi vào tài khoản.</p>
@if(Model.Temporary.Count==0){<div class="empty"><h3>Chưa có điểm đến trong tập tạm</h3><p>Vào chi tiết điểm đến và chọn “Thêm vào tham khảo”.</p><a class="secondary" href="/">Khám phá Việt Nam ↗</a></div>}else{<div class="cards">@foreach(var p in Model.Temporary){<article class="panel"><span class="eyebrow">@p.Region · @p.Category</span><h3><a href="/Home/Place/@p.Id">@p.Name ↗</a></h3><p>@p.Description</p><form asp-action="RemoveTemporary" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="secondary">Bỏ khỏi tập tạm</button></form></article>}</div><div class="panel">@if(User.Identity?.IsAuthenticated==true){<form asp-action="SaveList" method="post" class="form-grid" style="grid-template-columns:1fr auto"><input type="hidden" name="operation" value="@Guid.NewGuid()"/><label>Tên danh sách<input name="name" required minlength="2" maxlength="150" placeholder="Những nơi muốn đến trong năm nay"/></label><button class="button">Lưu danh sách vào tài khoản</button></form>}else{<p>Đăng nhập để lưu tập tham khảo vào tài khoản của bạn.</p><a class="button" href="/Account/Login?returnUrl=/Library">Đăng nhập để lưu ↗</a>}<form asp-action="Clear" method="post" style="margin-top:12px"><button class="link-button">Xóa toàn bộ tập tạm</button></form></div>}
<h2 style="margin-top:45px">Danh sách đã lưu</h2>@if(User.Identity?.IsAuthenticated!=true){<p class="muted">Đăng nhập để xem các danh sách của bạn.</p>}else if(Model.Saved.Count==0){<p class="empty">Bạn chưa lưu danh sách nào.</p>}else{<div class="cards">@foreach(var l in Model.Saved){<article class="panel"><span class="eyebrow">@l.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy") · @l.Items.Count điểm đến</span><h3><a asp-action="Details" asp-route-id="@l.Id">@l.Name ↗</a></h3><p>@string.Join(" · ",l.Items.Select(x=>x.Place?.Name))</p><a asp-action="Details" asp-route-id="@l.Id" class="secondary">Mở danh sách</a></article>}</div>}</section>
