@model SavedReferenceList
@{ViewData["Title"] = Model.Name;}
<section class="section workspace"><a asp-action="Index" class="muted">← Tất cả danh sách</a><div class="page-heading" style="margin-top:20px"><div><span class="eyebrow">THÔNG TIN ĐÃ LƯU</span><h1>@Model.Name</h1><p class="muted">@Model.Items.Count điểm đến · Tạo ngày @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p></div><a class="button" href="/Journey">Lên kế hoạch chuyến đi ↗</a></div><div class="cards">@foreach(var item in Model.Items){if(item.Place is not {} p){continue;}<article class="panel"><span class="eyebrow">@p.Region · @p.Category</span><h2><a href="/Home/Place/@p.Id">@p.Name ↗</a></h2><p>@p.Description</p><p class="muted">Ngân sách gợi ý: @p.Price.ToString("N0") ₫</p><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="item" value="@item.Id"/><button class="secondary">Bỏ khỏi danh sách</button></form></article>}</div>@if(Model.Items.Count==0){<p class="empty">Danh sách đang trống. Bạn có thể tạo danh sách mới từ tập tham khảo tạm.</p>}<form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="secondary" style="color:#a3392f" data-confirm="Xóa danh sách tham khảo này?">Xóa danh sách</button></form></section>
