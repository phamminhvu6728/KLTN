@model GovernanceList
@{ViewData["Title"]="Quyền hoạt động nhà cung cấp";}
<section class="section"><div class="page-heading"><div><span class="eyebrow">SUC13.01 · QUẢN TRỊ</span><h1>Quyền hoạt động nhà cung cấp</h1></div><a class="secondary" href="/Verification">Hồ sơ xác minh ↗</a></div>
<form method="get" class="panel toolbar"><label>Lọc danh sách<select name="filter"><option value="">Tất cả đã xác minh / thu hồi</option><option value="review" selected="@(Model.Filter=="review")">Cần xem xét / đến hạn</option>@foreach(var s in new[]{"Đang hoạt động","Tạm đình chỉ","Đã thu hồi"}){<option value="@s" selected="@(Model.Filter==s)">@s</option>}</select></label><button class="button">Áp dụng bộ lọc</button></form>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Nhà cung cấp</th><th>Xác minh</th><th>Quyền hoạt động</th><th>Cần xem xét</th><th></th></tr></thead><tbody>@foreach(var p in Model.Providers){var current=Model.Decisions.FirstOrDefault(d=>d.Id==p.CurrentGovernanceDecisionId);var pending=Model.Explanations.Count(e=>e.OwnerId==p.Id&&e.Status=="Chờ xem xét");<tr><td><strong>@p.Name</strong><br/><small>@p.Email</small></td><td>@p.VerificationStatus</td><td><span class="pill">@p.ProviderStatus</span></td><td>@if(pending>0){<span>@pending giải trình mới</span>}@if(p.ProviderStatus=="Tạm đình chỉ"&&current?.Until?.Date<=DateTime.UtcNow.AddHours(7).Date){<span class="text-danger"> · Đã đến hạn</span>}</td><td><a href="/Governance/Details/@p.Id" class="secondary">Xem và xử lý →</a></td></tr>}</tbody></table>@if(!Model.Providers.Any()){<div class="empty">Không có nhà cung cấp phù hợp bộ lọc.</div>}</div></section>
