@model GovernanceDetail
@{ViewData["Title"]=Model.IsAdmin?"Xem xét nhà cung cấp":"Quyền hoạt động của tôi";var p=Model.Provider;var current=Model.Decisions.FirstOrDefault(d=>d.Id==p.CurrentGovernanceDecisionId);}
<section class="section"><div class="page-heading"><div><span class="eyebrow">SUC13.01 · @(Model.IsAdmin?"XEM XÉT QUYỀN HOẠT ĐỘNG":"NHÀ CUNG CẤP")</span><h1>@p.Name</h1><p>@p.Email · Xác minh: @p.VerificationStatus</p><span class="badge-status">@(p.ProviderStatus??"Chưa xác lập quyền hoạt động")</span>@if(!p.IsActive){<span class="badge-status">Tài khoản đã ngừng</span>}</div><a class="secondary" href="@(Model.IsAdmin?"/Governance":"/Provider")">← Trở lại</a></div>
@if(current!=null){<article class="panel"><h2>Quyết định hiện hành #@current.Id</h2><p><strong>@current.Before → @current.After</strong></p><p>Lý do: @current.Reason</p><p>Căn cứ: @current.Evidence</p><p class="muted">Admin #@current.AdminId · @current.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") (Việt Nam)@if(current.Until.HasValue){<span> · Xem xét lại: @current.Until.Value.ToString("dd/MM/yyyy")</span>}</p></article>}
@if(Model.IsAdmin){<article class="panel"><h2>Ghi quyết định</h2><div asp-validation-summary="All" class="validation-error" role="alert"></div>@if(p.IsActive&&p.VerificationStatus=="Đã xác minh"&&p.ProviderStatus is "Đang hoạt động" or "Tạm đình chỉ"){<form asp-action="Preview" method="post"><input asp-for="Input.ProviderId" name="ProviderId" type="hidden"/><input asp-for="Input.Version" name="Version" type="hidden"/><div class="form-grid"><label>Thao tác<select name="Action">@if(p.ProviderStatus=="Đang hoạt động"){<option value="Suspend">Tạm đình chỉ</option>}else{<option value="Restore">Khôi phục</option><option value="Keep">Giữ nguyên quyết định</option>}<option value="Revoke">Thu hồi quyền hoạt động</option></select></label><label>Thời hạn dự kiến (chỉ khi tạm đình chỉ)<input type="date" name="Until" value="@Model.Input.Until?.ToString("yyyy-MM-dd")" min="@DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-dd")"/></label><label>Giải trình đang xem xét<select name="ExplanationId"><option value="">Không gắn giải trình</option>@foreach(var e in Model.Explanations.Where(x=>x.Status=="Chờ xem xét")){<option value="@e.Id">Giải trình #@e.Id · @e.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</option>}</select></label></div><label>Lý do quyết định<textarea name="Reason" required maxlength="2000">@Model.Input.Reason</textarea></label><label>Căn cứ đã đối chiếu<textarea name="Evidence" required maxlength="3000">@Model.Input.Evidence</textarea></label><button class="button">Xem hệ quả trước khi xác nhận →</button></form>}else{<p>Trạng thái hiện hành không cho phép thao tác quản lý quyền. Với hồ sơ chưa xác minh hoặc đã thu hồi, xử lý tại <a href="/Verification">Xác minh nhà cung cấp</a>.</p>}</article>}
else if(p.ProviderStatus=="Tạm đình chỉ"&&p.IsActive){<article class="panel"><h2>Gửi giải trình / đề nghị khôi phục</h2><p class="muted">Việc gửi giải trình không tự mở lại quyền. Bạn vẫn có thể xử lý đổi/hủy và ghi kết quả các thỏa thuận đã xác nhận.</p>@if(Model.Explanations.Any(x=>x.DecisionId==p.CurrentGovernanceDecisionId&&x.Status=="Chờ xem xét")){<p class="badge-status">Đã có giải trình chờ Admin xem xét.</p>}else{<form asp-action="Explain" method="post" enctype="multipart/form-data"><label>Nội dung và căn cứ giải trình<textarea name="content" required maxlength="5000"></textarea></label><label>Tài liệu đính kèm (không bắt buộc)<input type="file" name="files" accept=".pdf,.jpg,.jpeg,.png" multiple/></label><p class="muted">Tối đa 5 tệp PDF/JPG/PNG, 5 MB/tệp. Chỉ bạn và Admin được đọc.</p><button class="button">Gửi để Admin xem xét</button></form>}</article>}
else if(p.ProviderStatus=="Đã thu hồi"){<p class="notice">Muốn hoạt động lại, cần nộp hồ sơ xác minh mới. Các thỏa thuận đã xác nhận vẫn được bảo toàn.</p><a class="button" href="/Verification/Mine">@(Model.IsAdmin?"Xem hồ sơ xác minh":"Nộp hồ sơ xác minh lại")</a>}
<h2>Giải trình và kết quả xem xét</h2>@if(!Model.Explanations.Any()){<p class="muted">Chưa có giải trình.</p>}@foreach(var e in Model.Explanations){<article class="panel"><span class="badge-status">@e.Status</span><h3>Giải trình #@e.Id · Quyết định #@e.DecisionId</h3><p style="white-space:pre-line">@e.Content</p>@foreach(var d in Model.Documents.Where(x=>x.ObjectId==e.Id)){<a class="secondary" href="/Verification/Download/@d.Id">↓ @d.OriginalName</a>}@if(e.ReviewedAt.HasValue){<p><strong>Kết quả xem xét:</strong> @e.ReviewReason</p><p>Căn cứ: @e.ReviewEvidence</p><p class="muted">Admin #@e.ReviewerId · @e.ReviewedAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>}</article>}
<h2>Lịch sử quyết định</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Quyết định / thời điểm</th><th>Trước → Sau</th><th>Lý do và căn cứ</th><th>Người quyết định</th></tr></thead><tbody>@foreach(var d in Model.Decisions){<tr><td>#@d.Id<br/>@d.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td>@d.Before → @d.After</td><td>@d.Reason<br/><small>@d.Evidence</small></td><td>Admin #@d.AdminId</td></tr>}</tbody></table></div>
<h2>Dịch vụ và nghĩa vụ liên quan</h2><div class="cards"><div class="panel"><h3>Dịch vụ đang quản lý</h3>@foreach(var s in Model.Services){<p><strong>@s.Name</strong><br/><small>@s.ApprovalStatus · @(s.IsPublished?"Nội dung được giữ":"Ngừng công bố") · @(s.IsAccepting?"Tiếp nhận yêu cầu mới":"Không tiếp nhận yêu cầu mới")</small></p>}</div><div class="panel"><h3>Yêu cầu / thỏa thuận</h3><p class="muted">Tạm đình chỉ / thu hồi không tự hủy các thỏa thuận đã xác nhận.</p>@foreach(var b in Model.Bookings){<p><strong>#@b.Id · @b.SnapshotName</strong><br/><small>@b.Status · @b.Date.ToString("dd/MM/yyyy") · @b.Total.ToString("N0") ₫</small>@if(!string.IsNullOrEmpty(b.Feedback)){<br/><span>Phản ánh: @b.Feedback</span>}</p>}</div></div></section>
