@model GovernancePreview
@{ViewData["Title"]="Xác nhận hệ quả quyết định";}
<section class="section narrow"><span class="eyebrow">SUC13.01 · KIỂM TRA TRƯỚC KHI GHI</span><h1>Xác nhận quyết định về @Model.ProviderName</h1><article class="panel"><h2>@Model.Before → @Model.After</h2><p><strong>Lý do:</strong> @Model.Input.Reason</p><p><strong>Căn cứ:</strong> @Model.Input.Evidence</p>@if(Model.Input.Action is "Suspend" or "Revoke"){<p>@Model.ServiceCount dịch vụ sẽ không tiếp nhận yêu cầu mới. @Model.PendingCount yêu cầu chưa chốt sẽ chuyển “Không tiếp tục” và khách liên quan được thông báo.</p><p>@Model.ConfirmedCount thỏa thuận đã xác nhận / chờ kiểm tra được giữ nguyên; nhà cung cấp vẫn được xử lý các nghĩa vụ đã có.</p>@if(Model.Input.Action=="Revoke"){<p><strong>Thu hồi:</strong> ngừng công bố các dịch vụ, từ chối bản đang chờ duyệt và chuyển kết quả xác minh thành “Đã thu hồi”. Không xóa lịch sử.</p>}}else if(Model.Input.Action=="Restore"){<p>Chỉ dịch vụ bị ngừng tiếp nhận do đúng quyết định đình chỉ hiện hành được mở lại. Yêu cầu đã “Không tiếp tục” không tự mở lại.</p>}else{<p>Giữ nguyên quyền và trạng thái vận hành. Kết quả xem xét cùng lý do/căn cứ được lưu vào lịch sử.</p>}<form asp-action="Confirm" method="post"><input type="hidden" name="operation" value="@Model.OperationId"/><button class="button">Xác nhận áp dụng đồng bộ</button><a class="secondary" href="/Governance/Details/@Model.Input.ProviderId">Hủy, không thay đổi</a></form></article></section>
