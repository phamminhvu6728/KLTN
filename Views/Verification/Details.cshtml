@model VerificationDetailsVm
@{ViewData["Title"]="Hồ sơ xác minh";var dossier=Model.Dossier;var canSubmit=!Model.IsAdmin&&(Model.Account.VerificationStatus is "Cần bổ sung" or "Từ chối" or "Đã thu hồi");var supplement=Model.Account.VerificationStatus=="Cần bổ sung";}
<section class="section workspace"><div class="page-heading"><div><span class="eyebrow">SUC10.02 · HỒ SƠ XÁC MINH</span><h1>@(Model.Provider?.CompanyName??Model.Account.Name)</h1><p class="muted">Xác minh và quyền hoạt động là hai trạng thái riêng biệt.</p></div><div><span class="badge-status">@Model.Account.VerificationStatus</span><span class="badge-status">@(Model.Account.ProviderStatus??"Chưa mở quyền hoạt động")</span></div></div><div asp-validation-summary="All" class="validation-error" role="alert"></div><div class="cards"><article class="panel"><h2>Thông tin tài khoản, cơ sở</h2><dl><dt>Người đăng ký</dt><dd>@Model.Account.Name</dd><dt>Email / điện thoại</dt><dd>@Model.Account.Email · @Model.Account.Phone</dd><dt>Tình trạng tài khoản</dt><dd>@(Model.Account.IsActive?"Đang sử dụng":"Đã ngừng sử dụng")</dd>@if(Model.Provider is {} p){<dt>Loại hình cơ sở</dt><dd>@p.CompanyType</dd><dt>Địa chỉ</dt><dd>@p.Address</dd><dt>Liên hệ cơ sở</dt><dd>@p.ContactName · @p.ContactPhone · @p.ContactEmail</dd>}</dl><p class="muted">Đây là hồ sơ nghiệp vụ, chỉ chủ tài khoản và Admin được truy cập.</p></article><article class="panel"><h2>Hồ sơ hiện xem @(dossier is null?"":$"#{dossier.Id}")</h2>@if(dossier is null){<p>Chưa có hồ sơ xác minh.</p>}else{<span class="badge-status">@dossier.Status</span><p><strong>Người đứng tên:</strong> @dossier.Representative</p><p style="white-space:pre-wrap">@dossier.Content</p><p class="muted">@dossier.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @dossier.Submission lần bổ sung</p><h3>Tài liệu đã nộp</h3>@foreach(var group in Model.Documents.Where(x=>x.ObjectId==dossier.Id).GroupBy(x=>x.Submission)){<p class="muted">@(group.Key==0?"Hồ sơ ban đầu":$"Lần bổ sung {group.Key}")</p>@foreach(var file in group){<p><a asp-action="Download" asp-route-id="@file.Id" class="secondary">↓ @file.OriginalName <small>(@Math.Ceiling(file.Size/1024m) KB)</small></a></p>}}@if(!Model.Documents.Any(x=>x.ObjectId==dossier.Id)){<p class="muted">Chưa có tệp tài liệu. Không thể xác minh khi thiếu bằng chứng.</p>}}</article></div>
@if(Model.IsAdmin&&dossier is not null&&dossier.Status=="Chờ xác minh"&&Model.Account.IsActive){<form asp-action="Decide" method="post" class="panel"><h2>Ghi quyết định xác minh</h2><input type="hidden" name="id" value="@dossier.Id"/><input type="hidden" name="version" value="@Model.Decision.Version"/><label>Kết quả<select name="outcome"><option selected="@(Model.Decision.Outcome=="Đã xác minh")">Đã xác minh</option><option selected="@(Model.Decision.Outcome=="Cần bổ sung")">Cần bổ sung</option><option selected="@(Model.Decision.Outcome=="Từ chối")">Từ chối</option></select></label><label>Lý do (bắt buộc khi cần bổ sung hoặc từ chối)<textarea name="reason" maxlength="500">@Model.Decision.Reason</textarea></label><label>Nhận xét xác minh<textarea name="comment" maxlength="500">@Model.Decision.Comment</textarea></label><button class="button">Lưu quyết định và thông báo nhà cung cấp</button><a asp-action="Index" class="secondary">Quay lại danh sách</a></form>}
@if(canSubmit){<form asp-action="Submit" method="post" enctype="multipart/form-data" class="panel"><h2>@(supplement?"Bổ sung hồ sơ theo yêu cầu":"Nộp hồ sơ xác minh mới")</h2><p class="muted">@(supplement?"Nội dung và tài liệu được lưu thành một lần bổ sung mới trong hồ sơ hiện hành; lịch sử trước đó được giữ lại.":"Hồ sơ cũ và các quyết định được giữ lại. Hồ sơ mới sẽ chuyển về Chờ xác minh, không tự mở quyền cung cấp dịch vụ.")</p><input type="hidden" name="version" value="@Model.Submission.Version"/><label>Người đứng tên<input name="representative" value="@Model.Submission.Representative" required maxlength="100"/></label><label>Nội dung đăng ký<textarea name="content" maxlength="2000" required>@Model.Submission.Content</textarea></label><label>Tài liệu (1–5 tệp PDF/JPG/PNG, tối đa 5 MB/tệp)<input name="files" type="file" accept=".pdf,.jpg,.jpeg,.png" multiple required/></label><button class="button">Gửi hồ sơ chờ Admin xem xét ↗</button><a asp-action="Mine" class="secondary">Hủy</a></form>}
<article class="panel"><h2>Các phiên bản nội dung hồ sơ</h2>@foreach(var submission in Model.Submissions.OrderByDescending(x=>x.SubmittedAt)){<details><summary>Hồ sơ #@submission.DossierId · Lần nộp @submission.Submission · @submission.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</summary><p><strong>Người đứng tên:</strong> @submission.Representative</p><p style="white-space:pre-wrap">@submission.Content</p></details>}</article><article class="panel"><h2>Lịch sử quyết định</h2>@if(Model.Decisions.Count==0){<p class="muted">Chưa có quyết định xác minh.</p>}@foreach(var d in Model.Decisions.OrderByDescending(x=>x.CreatedAt)){<div class="timeline"><div><strong>Hồ sơ #@d.DossierId · Lần xử lý @d.Sequence · @d.Outcome</strong><p>@d.Reason</p><p>@d.Comment</p><small>@Model.AdminNames.GetValueOrDefault(d.AdminId,"Admin") · @d.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div></div>}</article>
@if(Model.History.Count>1){<article class="panel"><h3>Các lần nộp hồ sơ</h3>@foreach(var h in Model.History){<p>@if(Model.IsAdmin){<a asp-action="Details" asp-route-id="@h.Id">Hồ sơ #@h.Id · @h.Status ↗</a>}else{<span>Hồ sơ #@h.Id · @h.Status · @h.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>}</p>}</article>}
<a class="secondary" href="@(Model.IsAdmin?"/Verification":"/Provider")">← @(Model.IsAdmin?"Danh sách xác minh":"Khu vực nhà cung cấp")</a></section>
<style>.validation-error{color:#a3392f}dt{font-size:12px;color:#6e806c;margin-top:16px}dd{font-size:14px;line-height:1.7}</style>


