@model VerificationQueueVm
@{ViewData["Title"]="Xác minh nhà cung cấp";}
<section class="section workspace"><div class="page-heading"><div><span class="eyebrow">SUC10.02 · QUẢN TRỊ</span><h1>Xác minh nhà cung cấp</h1><p class="muted">Xem hồ sơ, tài liệu và ghi quyết định trên đúng phiên bản.</p></div><a class="secondary" href="/Admin">Quay lại quản trị</a></div><div class="chips">@foreach(var s in new[]{"Chờ xác minh","Cần bổ sung","Đã xác minh","Từ chối"}){<a asp-action="Index" asp-route-status="@s">@s</a>}</div><h2>@Model.Status <span class="badge-status">@Model.Dossiers.Count hồ sơ</span></h2>@if(Model.Dossiers.Count==0){<div class="empty">Hiện không có hồ sơ ở trạng thái này. Không có quyết định nào được tạo.</div>}else{<div class="cards">@foreach(var d in Model.Dossiers){<article class="panel"><span class="badge-status">@d.Status</span><h3>@Model.Names.GetValueOrDefault(d.OwnerId,$"Nhà cung cấp #{d.OwnerId}")</h3><p>Hồ sơ #@d.Id · Người đứng tên: @d.Representative</p><p class="muted">Gửi lúc @d.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Bổ sung @d.Submission lần</p><a asp-action="Details" asp-route-id="@d.Id" class="button">Xem hồ sơ và tài liệu ↗</a></article>}</div>}</section>
