<dialog id="action-confirmation" class="action-confirmation" aria-labelledby="confirmation-title" aria-describedby="confirmation-message">
    <div class="confirmation-content">
        <span class="eyebrow">KIỂM TRA TRƯỚC KHI LƯU</span>
        <h2 id="confirmation-title">Xác nhận thao tác</h2>
        <p id="confirmation-message"></p>
        <dl id="confirmation-summary" class="confirmation-summary"></dl>
        
        <div class="confirmation-actions">
            <button type="button" id="confirmation-cancel" class="secondary" autofocus>Quay lại</button>
            <button type="button" id="confirmation-accept" class="button">Có, xác nhận</button>
        </div>
    </div>
</dialog>
<style>
    .action-confirmation{border:1px solid #d7dfd0;border-radius:18px;padding:0;width:min(580px,calc(100% - 32px));max-height:85dvh;color:#183f37;box-shadow:0 24px 80px #102d2840}
    .action-confirmation::backdrop{background:rgb(12 30 26 / 58%);backdrop-filter:blur(3px)}
    .confirmation-content{padding:30px}.confirmation-content h2{margin:12px 0 18px;font-size:28px}
    .confirmation-summary{background:#f4f6f1;border-radius:10px;padding:16px;max-height:32dvh;overflow:auto;overflow-wrap:anywhere}
    .confirmation-summary:empty{display:none}.confirmation-summary dt{font-size:12px;color:#617269;margin-top:12px}.confirmation-summary dt:first-child{margin-top:0}
    .confirmation-summary dd{white-space:pre-wrap;margin:3px 0 0}.confirmation-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px;margin-top:22px}
    .confirmation-actions .danger{background:#a13d32}.confirmation-actions button:focus-visible{outline:3px solid #deab54;outline-offset:3px}
    @@media(max-width:600px){.confirmation-content{padding:22px}.confirmation-actions button{flex:1}}
</style>
