@inject IConfiguration Configuration
@{
    var controller=ViewContext.RouteData.Values["controller"]?.ToString()??"";
    var action=ViewContext.RouteData.Values["action"]?.ToString()??"";
    var logged=User.Identity?.IsAuthenticated==true;
    var traveler=User.IsInRole("Traveler"); var provider=User.IsInRole("Provider"); var admin=User.IsInRole("Admin");
    var internalPage=logged&&(new[]{"Dashboard","Journey","Provider","Admin","Governance","Verification"}.Contains(controller)||controller=="Account"&&action is not ("Login" or "Register")||controller=="Marketplace"&&action!="Index"&&action!="Details"||controller=="Community"&&action!="Index"&&action!="Details");
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#183f37"/><title>@ViewData["Title"] · Đi & Khám phá</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true"/></head><body>
<header><a class="brand" href="/" aria-label="Đi — Trang chủ">đi<span>⤴</span><small>TỰ TÚC · TỰ DO</small></a><nav class="top-nav"><a href="/">Khám phá</a><a class="@(action=="Search"?"active":"")" href="/Home/Search">Tra cứu</a>@if(traveler||!logged){<a class="@(controller=="Journey"?"active":"")" href="/Journey">Chuyến đi</a>}<a class="@(controller=="Community"?"active":"")" href="/Community">Đồng hành</a><a class="@(controller=="Marketplace"?"active":"")" href="/Marketplace">Dịch vụ</a></nav><div class="account">@if(logged){<a class="notification-icon" href="/Dashboard/Notifications" title="Thông báo">♧</a><a class="account-link" href="/Dashboard"><span class="avatar-letter">@User.Identity!.Name?.FirstOrDefault()</span><span>@User.Identity.Name<small>@(admin?"Quản trị viên":provider?"Nhà cung cấp":"Khách du lịch")</small></span></a>}else{<a class="button small" href="/Account/Login">Đăng nhập ↗</a>}</div></header>
@if(Configuration.GetValue<bool>("Demo:Enabled")){<div class="demo-bar"><span><i></i> KHÔNG GIAN DEMO <small>· Chọn vai trò để trải nghiệm</small></span><div><form asp-controller="Account" asp-action="LoginDemo" method="post"><button name="role" value="Traveler" class="@(traveler?"selected":"")">🎒 Khách du lịch</button></form><form asp-controller="Account" asp-action="LoginDemo" method="post"><button name="role" value="Provider" class="@(provider?"selected":"")">⌂ Nhà cung cấp</button></form><form asp-controller="Account" asp-action="LoginDemo" method="post"><button name="role" value="Admin" class="@(admin?"selected":"")">◇ Quản trị</button></form></div></div>}
@if(TempData["Message"] is string message){<div class="notice" role="status">@message<button type="button" aria-label="Đóng thông báo" onclick="this.parentElement.remove()">×</button></div>}
<div class="@(internalPage?"app-shell":"public-shell")">@if(internalPage){<aside class="sidebar"><span class="sidebar-label">KHÔNG GIAN CỦA BẠN</span><a class="@(controller=="Dashboard"&&action=="Index"?"active":"")" href="/Dashboard"><b>▦</b> Tổng quan</a>@if(traveler){<a class="@(controller=="Journey"&&action!="Incidents"?"active":"")" href="/Journey"><b>↗</b> Chuyến đi của tôi</a><a class="@(controller=="Community"?"active":"")" href="/Community/Dashboard"><b>♧</b> Kết nối đồng hành</a><a class="@(controller=="Marketplace"?"active":"")" href="/Marketplace/Requests"><b>▤</b> Yêu cầu dịch vụ</a><a class="@(action=="Incidents"?"active":"")" href="/Journey/Incidents"><b>☂</b> Tình huống phát sinh</a>}
@if(provider){<span class="sidebar-label">NHÀ CUNG CẤP</span><a class="@(controller=="Provider"&&action=="Index"?"active":"")" href="/Provider"><b>⌂</b> Quản lý dịch vụ</a><a class="@(controller=="Provider"&&action=="Requests"?"active":"")" href="/Provider/Requests"><b>▣</b> Yêu cầu của khách</a><a class="@(controller=="Verification"?"active":"")" href="/Verification/Mine"><b>▧</b> Hồ sơ xác minh</a><a class="@(controller=="Governance"?"active":"")" href="/Governance/Mine"><b>◇</b> Quyền hoạt động</a>}
@if(admin){<span class="sidebar-label">QUẢN TRỊ</span><a class="@(controller=="Admin"?"active":"")" href="/Admin"><b>▣</b> Xét duyệt dịch vụ</a><a class="@(controller=="Verification"?"active":"")" href="/Verification"><b>▧</b> Xác minh nhà cung cấp</a><a class="@(controller=="Governance"?"active":"")" href="/Governance"><b>◇</b> Quyền hoạt động</a><a class="@(action=="Audit"?"active":"")" href="/Dashboard/Audit"><b>≡</b> Nhật ký hệ thống</a>}
<a class="@(action=="Notifications"?"active":"")" href="/Dashboard/Notifications"><b>◉</b> Thông báo</a><div class="sidebar-bottom">@if(!admin){<a href="/Account/Profile" class="@(controller=="Account"?"active":"")"><b>◎</b> Hồ sơ & tài khoản</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button><b>↪</b> Đăng xuất</button></form><div class="sidebar-tip">Một kế hoạch tốt.<br/><strong>Một hành trình của riêng bạn.</strong><a href="/Home/Search">Tìm cảm hứng mới ↗</a></div></div></aside>}<main>@RenderBody()</main></div>
<partial name="_ConfirmationDialog"/>
<footer><a class="brand" href="/">đi<span>⤴</span></a><p>Mỗi chuyến đi, một câu chuyện của riêng bạn.</p><small>Dữ liệu và ảnh minh họa · Website hỗ trợ du lịch tự túc</small></footer><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
