@model ProviderDashboardVm
@{ViewData["Title"]="Không gian nhà cung cấp";}
<section class="section"><div class="page-heading"><div><span class="eyebrow">NHÀ CUNG CẤP DỊCH VỤ</span><h1>Xin chào, @User.Identity?.Name</h1><p class="muted">@Model.Status</p></div><div><a href="/Provider/Requests" class="secondary">Yêu cầu & kết quả dịch vụ ↗</a>@if(Model.Verified){<a href="/Provider/Edit" class="button">+ Thêm dịch vụ</a>}</div></div>
@if(!Model.Verified){<div class="notice">Chưa có quyền đăng/cập nhật dịch vụ hoặc nhận yêu cầu mới. Bạn vẫn có thể xử lý thỏa thuận đã xác nhận, điều chỉnh và ghi kết quả.<br/><a href="/Verification/Mine">Xem hồ sơ xác minh</a> · <a href="/Governance/Mine">Xem quyết định và gửi giải trình</a></div>}
<div class="stat-grid"><div class="stat-card"><span>Dịch vụ của bạn</span><strong>@Model.Services.Count</strong></div><div class="stat-card"><span>Phiên bản chờ duyệt</span><strong>@Model.Revisions.Count(x=>x.Status=="Chờ duyệt")</strong></div><div class="stat-card"><span>Yêu cầu chờ phản hồi</span><strong>@Model.Bookings.Count(x=>TuTuc.Services.MarketplaceManager.PendingBookingStates.Contains(x.Status))</strong></div><div class="stat-card"><span>Thỏa thuận đã xác nhận</span><strong>@Model.Bookings.Count(x=>x.Status=="Đã xác nhận")</strong></div></div><h2>Dịch vụ của tôi</h2>@if(!Model.Services.Any()){<div class="empty">Chưa có dịch vụ. Tạo bản nháp đầu tiên khi hồ sơ đã được xác minh.</div>}
@foreach(var s in Model.Services){var revisions=Model.Revisions.Where(x=>x.TravelServiceId==s.Id).ToList();<article class="panel"><div class="section-heading"><div><span class="badge-status">@s.ApprovalStatus · @(s.IsAccepting?"Tiếp nhận theo quyền hiện hành":"Không tiếp nhận mới")</span><h2>@s.Name</h2><p class="muted">@s.Location · @s.Category · @s.Price.ToString("N0") ₫ / đơn vị</p></div>@if(Model.Verified&&!revisions.Any(x=>x.Status=="Chờ duyệt")){<a class="secondary" href="/Provider/Edit/@s.Id">@(s.ApprovalStatus=="Nháp"?"Mở bản nháp":"Gửi bản cập nhật")</a>}</div><p>@s.Description</p>@if(s.ClosureStart.HasValue){<p>Tạm ngừng đã duyệt: @s.ClosureStart.Value.ToString("dd/MM/yyyy") – @(s.ClosureEnd?.ToString("dd/MM/yyyy")??"chưa xác định ngày kết thúc") · @s.ClosureReason · @s.ClosureScope</p>}<details><summary>Lịch sử nội dung và quyết định</summary>@foreach(var r in revisions){<div class="change-item"><strong>Phiên bản @r.RevisionNumber · @r.Status</strong><p>@r.Name · @r.Price.ToString("N0") ₫</p><p>@r.ReviewNote</p><small>@r.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") · @(r.ReviewedAt.HasValue?"Xét duyệt "+r.ReviewedAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm"):"Chưa có quyết định")</small></div>}</details></article>}
<p class="muted">Trạng thái tiếp nhận do hệ thống cập nhật theo quyền hoạt động và trạng thái tài khoản; chỉnh sửa nội dung không tự thay đổi thỏa thuận đã xác nhận.</p></section>

