@model ServiceEditVm
@{ViewData["Title"]=Model.Id>0?"Cập nhật dịch vụ":"Thêm dịch vụ";}
<section class="section narrow provider-editor">
 <div class="page-heading"><div><span class="eyebrow">DỊCH VỤ CỦA BẠN</span><h1>@ViewData["Title"]</h1></div><a class="secondary" href="/Provider">← Danh sách dịch vụ</a></div>
 @if(!string.IsNullOrEmpty(ViewBag.ReviewNote as string)){<p class="notice">Yêu cầu từ quản trị: @ViewBag.ReviewNote</p>}
 <form asp-action="Edit" method="post" class="panel">
  <div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/>
  <fieldset class="editor-section"><legend>Thông tin cơ bản</legend><label>Tên dịch vụ<input asp-for="Name" required maxlength="200"/></label><div class="market-terms-grid"><label>Loại dịch vụ<select asp-for="Category"><option>Trải nghiệm</option><option>Lưu trú</option><option>Di chuyển</option><option>Ăn uống</option></select></label><label>Nơi phục vụ<input asp-for="Location" required maxlength="200" list="destination-options" placeholder="Chọn từ gợi ý, ví dụ Đà Lạt"/></label>@await Component.InvokeAsync("DestinationOptions")</div><label>Mô tả<textarea asp-for="Description" maxlength="4000" placeholder="Dịch vụ gồm những gì, phù hợp với ai?"></textarea></label><label>Ảnh HTTPS hoặc ảnh nội bộ<input asp-for="Image" placeholder="https://… hoặc /images/dalat.jpg"/></label></fieldset>
  <fieldset class="editor-section"><legend>Giá và điều kiện phục vụ</legend><div class="market-terms-grid"><label>Giá tham khảo (₫)<input asp-for="Price" type="number" min="0" max="1000000000" required/></label><label>Giờ / thời gian phục vụ<input asp-for="ServingHours" maxlength="200"/></label></div><label>Điều kiện phục vụ<textarea asp-for="Conditions" maxlength="2000"></textarea></label></fieldset>
  <details class="editor-disclosure" open="@(Model.ClosureStart.HasValue)"><summary>Thông báo tạm ngừng phục vụ (gửi quản trị duyệt)</summary><div class="market-terms-grid"><label>Tạm ngừng từ<input asp-for="ClosureStart" type="date"/></label><label>Đến ngày (tùy chọn)<input asp-for="ClosureEnd" type="date"/></label></div><label>Lý do tạm ngừng<input asp-for="ClosureReason" maxlength="500"/></label><label>Phạm vi ảnh hưởng<input asp-for="ClosureScope" maxlength="500" placeholder="Toàn bộ dịch vụ / hạng mục hoặc khung giờ cụ thể"/></label></details>
  <p class="notice">Dịch vụ cần được duyệt trước khi công bố.</p><div class="editor-actions"><button class="button" name="Operation" value="Submit">Gửi xét duyệt</button>@if(Model.Id==0||(ViewBag.IsDraft as bool?)==true){<button class="secondary" name="Operation" value="SaveDraft">Lưu nháp</button>}<a class="text-link" href="/Provider">Hủy chỉnh sửa</a></div>
 </form>
</section>
