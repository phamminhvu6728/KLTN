@model ServiceEditVm
@{ViewData["Title"]=Model.Id>0?"Cập nhật dịch vụ":"Thêm dịch vụ";}
<section class="section narrow"><a href="/Provider" class="muted">← Dịch vụ của tôi</a><span class="eyebrow" style="margin-top:25px">NỘI DUNG CÔNG BỐ PHẢI QUA XÉT DUYỆT</span><h1>@ViewData["Title"]</h1>@if(!string.IsNullOrEmpty(ViewBag.ReviewNote as string)){<p class="notice">Yêu cầu từ quản trị: @ViewBag.ReviewNote</p>}<form asp-action="Edit" method="post" class="panel"><div asp-validation-summary="All" class="text-danger"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><label>Tên dịch vụ<input asp-for="Name" required maxlength="200"/></label><div class="market-terms-grid"><label>Loại dịch vụ<select asp-for="Category"><option>Trải nghiệm</option><option>Lưu trú</option><option>Di chuyển</option><option>Ăn uống</option></select></label><label>Địa điểm<input asp-for="Location" required maxlength="200"/></label><label>Giá tham khảo (₫)<input asp-for="Price" type="number" min="0" max="1000000000" required/></label></div><label>Mô tả<textarea asp-for="Description" maxlength="4000"></textarea></label><label>Giờ/thời gian phục vụ<input asp-for="ServingHours" maxlength="200"/></label><label>Điều kiện phục vụ<textarea asp-for="Conditions" maxlength="2000"></textarea></label><label>Ảnh HTTPS hoặc ảnh nội bộ<input asp-for="Image" placeholder="https://… hoặc /images/dalat.jpg"/></label><details open="@(Model.ClosureStart.HasValue)"><summary>Thông báo tạm ngừng phục vụ (gửi Admin duyệt)</summary><div class="market-terms-grid" style="margin-top:15px"><label>Tạm ngừng từ<input asp-for="ClosureStart" type="date"/></label><label>Đến ngày (tùy chọn)<input asp-for="ClosureEnd" type="date"/></label></div><label>Lý do tạm ngừng<input asp-for="ClosureReason" maxlength="500"/></label><label>Phạm vi ảnh hưởng<input asp-for="ClosureScope" maxlength="500" placeholder="Toàn bộ dịch vụ / hạng mục hoặc khung giờ cụ thể"/></label><p class="muted">Nội dung này chỉ hiển thị sau khi được duyệt. Bản đang công bố không tự bị ẩn hoặc xóa.</p></details><button class="button" name="Operation" value="Submit">Gửi xét duyệt ↗</button>@if(Model.Id==0||(ViewBag.IsDraft as bool?)==true){<button class="secondary" name="Operation" value="SaveDraft">Lưu nháp</button>}<a class="secondary" href="/Provider">Hủy chỉnh sửa</a></form></section>
