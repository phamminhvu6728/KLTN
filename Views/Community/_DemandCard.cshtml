@model DemandCard
<article class="panel companion-card"><span class="badge-status">@Model.TravelStyle</span><h2><a href="/Community/Details/@Model.Id">@Model.Destination</a></h2><p class="muted">@Model.Date.ToString("dd/MM/yyyy") — @Model.EndDate.ToString("dd/MM/yyyy") · @Model.OwnerName</p>@if(Model.MatchScore.HasValue){<div class="match"><span class="match-score @(Model.MatchScore<50?"low":"")">Phù hợp @Model.MatchScore%</span></div>}@if(Model.MatchReasons.Any()){<ul class="match-reasons">@foreach(var reason in Model.MatchReasons){<li>@reason</li>}</ul>}@if(Model.Description!=null){<p>@Model.Description</p>}else{<p class="muted">Nội dung chuyến đi được chia sẻ sau khi hai bên kết nối.</p>}@if(Model.Budget.HasValue){<p>Ngân sách gợi ý: @(Model.Budget>0?Model.Budget.Value.ToString("N0")+" ₫":"Trao đổi cùng nhau")</p>}<a class="secondary" href="/Community/Details/@Model.Id">Xem trong phạm vi chia sẻ →</a></article>
