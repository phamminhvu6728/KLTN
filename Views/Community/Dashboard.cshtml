@model CommunityDashboard
@{ViewData["Title"]="Kết nối đồng hành của tôi";}
<section class="section"><div class="section-heading"><div><span class="eyebrow">TRAO ĐỔI RÕ RÀNG · THỐNG NHẤT CÙNG NHAU</span><h1>Kết nối của tôi</h1><p class="muted">Đề nghị kết nối và thỏa thuận đồng hành là hai bước riêng.</p></div><a class="button" href="/Community/Compose">+ Công bố nhu cầu</a></div><div asp-validation-summary="All" class="notice"></div><div class="toolbar"><a class="secondary" href="#connections">Đề nghị & thỏa thuận (@Model.Connections.Count)</a><a class="secondary" href="#demands">Nhu cầu của tôi (@Model.Demands.Count)</a><a class="secondary" href="/Community">Tìm người đồng hành ↗</a></div>
<h2 id="connections" style="margin-top:35px">Đề nghị & thỏa thuận</h2>@if(!Model.Connections.Any()){<div class="empty">Chưa có đề nghị. Tìm người chung nơi đến hoặc công bố nhu cầu của bạn.</div>}
@foreach(var item in Model.Connections){var c=item.Connection;var received=item.Demand.OwnerId==Model.Me;var active=item.Agreements.FirstOrDefault(x=>x.Status=="Đã xác nhận");var pending=item.Agreements.FirstOrDefault(x=>x.Status=="Chờ xác nhận");var ended=item.Agreements.Any(x=>x.Kind=="Nội dung"&&(x.Status=="Đã ngừng"||x.Status=="Một bên đã rút"));var latest=item.Agreements.Select(x=>x.Revision).DefaultIfEmpty().Max();<article class="panel connection-card" id="connection-@c.Id"><div class="section-heading"><div><span class="eyebrow">@(received?"ĐỀ NGHỊ NHẬN ĐƯỢC":"ĐỀ NGHỊ ĐÃ GỬI") · #@c.Id</span><h3>Đồng hành cùng @item.OtherName</h3></div><span class="badge-status">@c.Status</span></div><p><strong>@item.Demand.Destination</strong> · @item.Demand.Date.ToString("dd/MM/yyyy") — @item.Demand.EndDate.ToString("dd/MM/yyyy")</p>@if(!string.IsNullOrWhiteSpace(c.Message)){<p class="connection-message">“@c.Message”</p>}@if(!string.IsNullOrWhiteSpace(item.OtherBio)){<p>@item.OtherBio</p>}@if(!string.IsNullOrWhiteSpace(item.OtherResidence)){<p class="muted">Nơi sống: @item.OtherResidence</p>}@if(!string.IsNullOrWhiteSpace(item.OtherInterests)){<p class="muted">Sở thích: @item.OtherInterests</p>}@if(!string.IsNullOrWhiteSpace(item.OtherEmail)||!string.IsNullOrWhiteSpace(item.OtherPhone)){<div class="notice">Liên hệ được đối phương cho phép chia sẻ: @item.OtherEmail · @item.OtherPhone</div>}
@if(c.Status=="Chờ phản hồi"){<form asp-action="Respond" method="post"><input name="id" type="hidden" value="@c.Id"/><input name="version" type="hidden" value="@Convert.ToBase64String(c.Version)"/>@if(received){<button class="button" name="decision" value="accept">Chấp nhận kết nối</button><button class="secondary" name="decision" value="reject">Từ chối</button>}else{<button class="secondary" name="decision" value="withdraw">Rút đề nghị</button>}</form>}
@if(c.Status=="Đã chấp nhận"){<div class="agreement-area"><h4>Thỏa thuận đồng hành</h4>@if(ended){<p class="notice">Thỏa thuận đã kết thúc. Các đề nghị cũ không thể làm thỏa thuận có hiệu lực trở lại.</p>}@if(active!=null){<div class="agreement-active"><span class="badge-status">Đang hiệu lực · Phiên bản @active.Revision</span><partial name="_AgreementContent" model="active"/></div>}else if(!ended){<p class="muted">Chưa có thỏa thuận được hai bên xác nhận.</p>}
@if(pending!=null){<div class="agreement-pending"><span class="badge-status">@pending.Kind · Chờ xác nhận · Phiên bản @pending.Revision</span><partial name="_AgreementContent" model="pending"/>@if(pending.ProposerId==Model.Me){<p class="muted">Bạn đã đề xuất. Bên còn lại cần xem và phản hồi cùng phiên bản.</p>}else{<form asp-action="Agreement" method="post"><input name="id" type="hidden" value="@pending.Id"/><input name="revision" type="hidden" value="@pending.Revision"/><input name="version" type="hidden" value="@Convert.ToBase64String(pending.Version)"/><label>Lý do nếu từ chối<input name="reason" maxlength="500" value="@ViewBag.DraftReason"/></label><button class="button" name="decision" value="accept">Xác nhận đúng phiên bản @pending.Revision</button><button class="secondary" name="decision" value="reject">Từ chối đề xuất</button></form>}@if(pending.Kind=="Nội dung"){<a class="secondary" href="/Community/Propose?connectionId=@c.Id">Đề xuất nội dung khác →</a>}</div>}
@if(!ended&&pending==null){<a class="secondary" href="/Community/Propose?connectionId=@c.Id">@(active==null?"+ Tạo thỏa thuận":"+ Đề nghị điều chỉnh")</a>@if(active!=null){<form asp-action="EndAgreement" method="post" class="inline-form"><input name="connectionId" type="hidden" value="@c.Id"/><input name="baseRevision" type="hidden" value="@latest"/><button class="secondary">Đề nghị hai bên cùng ngừng</button></form>}}
@if(active!=null){<details class="withdraw-area"><summary>Thông báo rút khỏi đồng hành ngay</summary><p class="muted">Thỏa thuận kết thúc ngay khi bạn xác nhận rút, kể cả đang có đề nghị sửa hoặc cùng ngừng. Bên còn lại được thông báo và không cần chấp thuận. Dịch vụ đã đặt không tự bị hủy.</p><form asp-action="Withdraw" method="post"><input name="connectionId" type="hidden" value="@c.Id"/><input name="version" type="hidden" value="@Convert.ToBase64String(active.Version)"/><label>Lý do (không bắt buộc)<textarea name="reason" maxlength="500">@ViewBag.DraftReason</textarea></label><button class="secondary danger-action">Xác nhận rút và kết thúc thỏa thuận</button></form></details>}
@if(item.Agreements.Any(x=>x.Status is not("Chờ xác nhận" or "Đã xác nhận"))){<details style="margin-top:22px"><summary>Lịch sử các phiên bản</summary>@foreach(var a in item.Agreements.Where(x=>x.Status is not("Chờ xác nhận" or "Đã xác nhận"))){<div class="agreement-history"><span class="badge-status">Phiên bản @a.Revision · @a.Status</span><partial name="_AgreementContent" model="a"/></div>}</details>}</div>}</article>}
<h2 id="demands" style="margin-top:45px">Nhu cầu của tôi</h2><div class="cards">@foreach(var d in Model.Demands){<article class="panel"><span class="badge-status">@(d.IsPublished?"Đang công bố":"Đã dừng công bố")</span><h3>@d.Destination</h3><p>@d.Date.ToString("dd/MM/yyyy") — @d.EndDate.ToString("dd/MM/yyyy")</p><p>@d.Description</p><p class="muted">Phạm vi: @(d.SharingScope=="Public"?"Công khai":d.SharingScope=="Registered"?"Khách đã đăng nhập":"Nội dung sau kết nối")</p><a class="secondary" href="/Community/Compose?id=@d.Id">Sửa / xem trước công bố lại</a>@if(d.IsPublished){<form asp-action="Stop" method="post" style="margin-top:15px"><input name="id" type="hidden" value="@d.Id"/><input name="version" type="hidden" value="@Convert.ToBase64String(d.Version)"/><button class="link-button">Dừng công bố</button></form>}</article>}</div>@if(!Model.Demands.Any()){<div class="empty"><p>Bạn chưa công bố nhu cầu.</p><a class="button" href="/Community/Compose">Công bố nhu cầu mới</a></div>}</section>
<style>.validation-summary-valid{display:none}.toolbar{display:flex;gap:12px;flex-wrap:wrap}.connection-message{padding:15px 20px;background:#f5f7f0;border-radius:8px}.agreement-area{border-top:1px solid #e4e9df;margin-top:25px;padding-top:25px}.agreement-active,.agreement-pending{padding:20px;background:#f4f7ec;border-radius:9px;margin:15px 0}.agreement-pending{background:#f9f4e8}.agreement-history{border-bottom:1px solid #e4e9df;padding:18px 0}.inline-form{display:inline-block}.withdraw-area{margin-top:24px;padding-top:20px;border-top:1px solid #eadad5}.danger-action{color:#993c31}</style>
