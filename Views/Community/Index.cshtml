@model CommunityPage
@{ViewData["Title"]="Tìm bạn đồng hành";var s=Model.Search;}
<section class="workspace section"><div class="section-heading"><div><span class="eyebrow">CHUNG ĐIỂM ĐẾN · CHUNG NIỀM VUI</span><h1>Đi cùng người đồng điệu.</h1><p class="muted">Tìm nhu cầu phù hợp nơi đến, khoảng thời gian và cách bạn muốn trải nghiệm.</p></div><a class="button" href="/Community/Dashboard">Kết nối & nhu cầu của tôi ↗</a></div><div asp-validation-summary="All" class="notice"></div>
<form method="get" class="panel"><div class="form-grid"><label>Điểm đến<input name="Q" value="@s.Q" maxlength="200" placeholder="Bạn muốn đến đâu?"/></label><label>Từ ngày<input name="From" type="date" value="@s.From?.ToString("yyyy-MM-dd")"/></label><label>Đến ngày<input name="To" type="date" value="@s.To?.ToString("yyyy-MM-dd")"/></label></div><div class="form-grid" style="margin-top:18px"><label>Ngân sách tối đa (₫)<input name="MaxBudget" type="number" min="0" max="1000000000" value="@s.MaxBudget?.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label><label>Hình thức đi<select name="TravelStyle"><option value="">Tất cả hình thức</option>@foreach(var style in TuTuc.Services.CommunityManager.TravelStyles){<option selected="@(s.TravelStyle==style)">@style</option>}</select></label><div><button class="button">Tìm đồng hành</button><a class="secondary" href="/Community">Xóa bộ lọc</a></div></div></form>
<p class="muted">@Model.Total nhu cầu phù hợp. @(Model.IsTraveler?"Nhu cầu của chính bạn được quản lý riêng trong Kết nối của tôi.":"Bạn đang xem các nhu cầu công khai.")</p><div class="cards">@foreach(var d in Model.Demands){<partial name="_DemandCard" model="d"/>}</div>@if(!Model.Demands.Any()){<div class="empty"><h3>Chưa có nhu cầu phù hợp</h3><p>Thử mở rộng khoảng ngày, ngân sách hoặc tự công bố nhu cầu của bạn.</p><a class="button" href="/Community/Compose">Công bố nhu cầu</a></div>}<div class="toolbar">@if(s.Page>1){<a class="secondary" asp-action="Index" asp-route-Q="@s.Q" asp-route-From="@s.From?.ToString("yyyy-MM-dd")" asp-route-To="@s.To?.ToString("yyyy-MM-dd")" asp-route-MaxBudget="@s.MaxBudget" asp-route-TravelStyle="@s.TravelStyle" asp-route-Page="@(s.Page-1)">← Trang trước</a>}@if(s.Page*20<Model.Total){<a class="secondary" asp-action="Index" asp-route-Q="@s.Q" asp-route-From="@s.From?.ToString("yyyy-MM-dd")" asp-route-To="@s.To?.ToString("yyyy-MM-dd")" asp-route-MaxBudget="@s.MaxBudget" asp-route-TravelStyle="@s.TravelStyle" asp-route-Page="@(s.Page+1)">Trang tiếp →</a>}</div><div class="panel"><h3>Từ lời chào đến chuyến đi</h3><p class="muted">Gửi đề nghị → Chấp nhận kết nối → Đề xuất nội dung đồng hành → Bên còn lại xác nhận đúng phiên bản. Kết nối được chấp nhận chưa phải thỏa thuận đi cùng.</p></div></section><style>.validation-summary-valid{display:none}.toolbar{display:flex;flex-wrap:wrap;gap:12px}</style>
