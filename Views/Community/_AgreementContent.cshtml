@model CompanionAgreement
<p><strong>@Model.Destination</strong> · @Model.Start.ToString("dd/MM/yyyy") — @Model.End.ToString("dd/MM/yyyy")</p><p><strong>Ngân sách:</strong> @(Model.Budget.HasValue?Model.Budget.Value.ToString("N0")+" ₫":"Chưa xác định")</p><p><strong>Cách chia chi phí:</strong> @Model.CostSharing</p><p><strong>Phạm vi đi cùng:</strong> @Model.Scope</p>@if(!string.IsNullOrWhiteSpace(Model.Content)){<p style="white-space:pre-wrap">@Model.Content</p>}@if(!string.IsNullOrWhiteSpace(Model.Reason)){<p><strong>Lý do:</strong> @Model.Reason</p>}@if(Model.EndedAt.HasValue){<p class="muted">Kết thúc bởi tài khoản #@Model.EndedBy · @Model.EndedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>}
