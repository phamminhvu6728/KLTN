@model DemandPreview
@{ViewData["Title"]="Xem trước nhu cầu đồng hành";}
<section class="section"><span class="eyebrow">CHƯA CÔNG BỐ · CHƯA GHI DỮ LIỆU NHU CẦU</span><h1>Kiểm tra cách người khác nhìn thấy</h1><div class="cards"><div><h2>Khách đã đăng nhập, chưa kết nối</h2><article class="panel"><partial name="_DemandContent" model="Model.RegisteredView"/></article></div><div><h2>Người chưa đăng nhập</h2>@if(Model.PublicView==null){<div class="empty">Nhu cầu không hiển thị với người chưa đăng nhập.</div>}else{<article class="panel"><partial name="_DemandContent" model="Model.PublicView"/></article>}</div></div><div class="toolbar"><form asp-action="Publish" method="post"><input type="hidden" name="token" value="@Model.Token"/><button class="button">Xác nhận công bố ✓</button></form><form asp-action="EditPreview" method="post"><input type="hidden" name="token" value="@Model.Token"/><button class="secondary">Quay lại sửa</button></form><a class="secondary" href="/Community/Dashboard">Hủy, không lưu</a></div></section><style>.toolbar{display:flex;flex-wrap:wrap;gap:12px}</style>

