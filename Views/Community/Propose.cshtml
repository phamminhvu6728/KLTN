@model AgreementPage
@{ViewData["Title"]="Đề xuất thỏa thuận đồng hành";var x=Model.Draft;var ended=Model.Item.Agreements.Any(a=>a.Kind=="Nội dung"&&(a.Status=="Đã ngừng"||a.Status=="Một bên đã rút"));var ending=Model.Item.Agreements.Any(a=>a.Kind=="Cùng ngừng"&&a.Status=="Chờ xác nhận");}
<section class="section narrow"><a class="muted" href="/Community/Dashboard#connection-@Model.Item.Connection.Id">← Về kết nối</a><span class="eyebrow" style="margin-top:25px">THỐNG NHẤT RÕ RÀNG TRƯỚC KHI ĐI</span><h1>Đề xuất thỏa thuận</h1><p>Với @Model.Item.OtherName · Kết nối #@Model.Item.Connection.Id</p><div asp-validation-summary="All" class="notice"></div>@if(ended||ending){<div class="notice">@(ended?"Thỏa thuận đã kết thúc, không nhận đề nghị mới.":"Đang có đề nghị cùng ngừng. Hãy phản hồi ở trang kết nối; bạn vẫn có quyền rút riêng.")</div>}else{<form asp-action="Propose" method="post" class="panel"><input name="ConnectionId" type="hidden" value="@x.ConnectionId"/><input name="BaseRevision" type="hidden" value="@x.BaseRevision"/><input name="PendingId" type="hidden" value="@x.PendingId"/><input name="PendingVersion" type="hidden" value="@x.PendingVersion"/><label>Nơi đến<input name="Destination" value="@x.Destination" maxlength="200" list="destination-options" required/>@await Component.InvokeAsync("DestinationOptions")</label><div class="form-grid"><label>Ngày đi<input name="Start" type="date" value="@x.Start.ToString("yyyy-MM-dd")" required/></label><label>Ngày về<input name="End" type="date" value="@x.End.ToString("yyyy-MM-dd")" required/></label></div><label>Ngân sách dự kiến (₫, có thể để trống)<input name="Budget" type="number" min="0" max="1000000000" value="@x.Budget?.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/></label><label>Cách chia chi phí<textarea name="CostSharing" maxlength="1000" required>@x.CostSharing</textarea></label><label>Phạm vi đi cùng<textarea name="Scope" maxlength="1000" required>@x.Scope</textarea></label><label>Ghi chú bổ sung<textarea name="Content" maxlength="2000">@x.Content</textarea></label><button class="button">Gửi phiên bản @(x.BaseRevision+1) cho bên còn lại</button><a class="secondary" href="/Community/Dashboard">Hủy, không gửi</a></form>}</section><style>.validation-summary-valid{display:none}</style>
