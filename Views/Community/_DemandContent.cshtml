@model DemandCard
<span class="eyebrow">@Model.TravelStyle · @Model.OwnerName</span><h2>@Model.Destination</h2><p>@Model.Date.ToString("dd/MM/yyyy") — @Model.EndDate.ToString("dd/MM/yyyy")</p>@if(Model.Limited){<p class="notice">Người đăng chỉ chia sẻ nội dung, mong muốn và ngân sách sau khi có kết nối được chấp nhận.</p>}else{<p style="white-space:pre-wrap">@Model.Description</p><p><strong>Mong muốn:</strong> @Model.Wishes</p><p>Ngân sách dự kiến: @(Model.Budget>0?Model.Budget?.ToString("N0")+" ₫":"Trao đổi cùng nhau") · @Model.People người mong muốn</p>}@if(!string.IsNullOrWhiteSpace(Model.Bio)){<p><strong>Giới thiệu:</strong> @Model.Bio</p>}@if(!string.IsNullOrWhiteSpace(Model.Residence)){<p>Nơi sống: @Model.Residence</p>}@if(!string.IsNullOrWhiteSpace(Model.Interests)){<p>Sở thích: @Model.Interests</p>}@if(!string.IsNullOrWhiteSpace(Model.Email)||!string.IsNullOrWhiteSpace(Model.Phone)){<div class="notice"><strong>Liên hệ được người đăng cho phép chia sẻ</strong><p>@Model.Email<br/>@Model.Phone</p></div>}
