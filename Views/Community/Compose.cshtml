@model DemandInput
@{ViewData["Title"]=Model.Id==0?"Công bố nhu cầu":"Sửa nhu cầu";}
<section class="section narrow"><a class="muted" href="/Community/Dashboard">← Nhu cầu của tôi</a><span class="eyebrow" style="margin-top:25px">BẠN QUYẾT ĐỊNH NHỮNG GÌ MUỐN CHIA SẺ</span><h1>@ViewData["Title"]</h1><div asp-validation-summary="All" class="notice"></div><form asp-action="Preview" method="post" class="panel"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><label>Điểm đến<input asp-for="Destination" maxlength="200" required/></label><div class="form-grid"><label>Ngày khởi hành<input asp-for="Date" type="date" required/></label><label>Ngày kết thúc<input asp-for="EndDate" type="date" required/></label></div><div class="form-grid" style="margin:18px 0"><label>Ngân sách gợi ý (₫)<input asp-for="Budget" type="number" min="0" max="1000000000"/></label><label>Số người mong muốn<input asp-for="People" type="number" min="1" max="20" required/></label><label>Hình thức đi<select asp-for="TravelStyle">@foreach(var style in TuTuc.Services.CommunityManager.TravelStyles){<option>@style</option>}</select></label></div><label>Nội dung nhu cầu<textarea asp-for="Description" maxlength="2000" required></textarea></label><label>Mong muốn với người đồng hành<textarea asp-for="Wishes" maxlength="1000"></textarea></label><label>Phạm vi chia sẻ<select asp-for="SharingScope"><option value="Connected">Sau khi kết nối — trước đó chỉ hiện nơi đến, ngày và hình thức đi</option><option value="Registered">Khách du lịch đã đăng nhập</option><option value="Public">Công khai, kể cả người chưa đăng nhập</option></select></label><label class="check-label"><input asp-for="ShareContact"/>Cho phép người đã kết nối xem liên hệ (cần bật chia sẻ liên hệ trong hồ sơ)</label><p class="muted">Email, số điện thoại luôn được ẩn với người chưa kết nối. Bạn sẽ thấy bản xem trước trước khi công bố.</p><button class="button">Xem trước nội dung ↗</button><a class="secondary" href="/Community/Dashboard">Hủy, không lưu</a></form></section><style>.validation-summary-valid{display:none}.check-label{display:flex;align-items:center;gap:12px}.check-label input{width:auto;margin:0}</style>
