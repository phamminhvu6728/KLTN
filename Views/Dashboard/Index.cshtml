@model DashboardVm
@using TuTuc.Services
@{ViewData["Title"]="Quản lý chuyến đi";var trip=Model.ActiveTrip;var total=trip?.Activities.Sum(x=>x.Cost??0)??0;var days=trip==null?0:Math.Max(1,(trip.End.Date-trip.Start.Date).Days+1);var ratio=trip?.Budget>0?Math.Min(100,total/trip.Budget.Value*100):trip!=null&&trip.Budget.HasValue&&total>0?100:0;}
<section class="section workbench" data-testid="travel-workspace">
 <div class="workspace-heading"><div><div class="workspace-breadcrumb">Không gian cá nhân <span>/</span> Tổng quan</div><h1>Quản lý chuyến đi</h1><p>Xin chào @User.Identity?.Name, bạn có <strong>@Model.TripCount kế hoạch</strong> và <strong>@Model.PendingCount yêu cầu đang chờ</strong>.</p></div><a class="button" href="/Journey#new-trip"><partial name="_TravelIcon" model='@("plus")'/>Tạo chuyến đi</a></div>
 <nav class="workspace-tabs" aria-label="Khu vực quản lý"><a class="selected" href="/Dashboard">Tổng quan</a><a href="/Journey">Tất cả chuyến đi <span>@Model.TripCount</span></a><a href="/Marketplace/Requests">Yêu cầu dịch vụ <span>@Model.RequestCount</span></a><a href="/Dashboard/Notifications">Thông báo <span>@Model.UnreadCount</span></a></nav>
 <div class="dashboard-shortcuts" aria-label="Lối tắt"><a href="/Home/Search"><span>⌕</span><strong>Tra cứu điểm đến</strong><small>Tìm nơi nên ghé</small><b>→</b></a><a href="/Marketplace"><span>▣</span><strong>Khám phá dịch vụ</strong><small>Lưu trú, ăn uống, di chuyển</small><b>→</b></a><a href="/Community"><span>♧</span><strong>Tìm bạn đồng hành</strong><small>Đi cùng người chung nhịp</small><b>→</b></a></div>
 <div class="workbench-columns"><div class="workbench-main">
 @if(trip!=null){
 <section class="workspace-card active-trip"><header class="workspace-card-header"><h2>Kế hoạch đang xem</h2><a href="/Journey/Details/@trip.Id" class="text-link">Mở kế hoạch <partial name="_TravelIcon" model='@("arrow")'/></a></header><form asp-controller="Dashboard" asp-action="Index" method="get" class="workspace-trip-selector"><label>Chọn chuyến đi<select name="tripId" onchange="this.form.requestSubmit()">@foreach(var choice in Model.TripChoices){<option value="@choice.Id" selected="@(choice.Id==trip.Id)">@choice.Name · @choice.Destination</option>}</select></label><button type="submit" class="secondary">Mở</button></form><div class="active-trip-summary"><img src="@TravelPresentation.Cover(trip.Destination)" alt="Ảnh minh họa điểm đến @trip.Destination"/><div><span class="badge-status @(trip.Status=="Đã chấp nhận"?"status-confirmed":"status-draft")">@trip.Status</span><h3><a href="/Journey/Details/@trip.Id">@trip.Name</a></h3><p><span><partial name="_TravelIcon" model='@("pin")'/>@trip.Destination</span><span><partial name="_TravelIcon" model='@("calendar")'/>@trip.Start.ToString("dd/MM") – @trip.End.ToString("dd/MM/yyyy")</span><span>@days ngày · @trip.Activities.Count hoạt động</span></p></div></div>
 <div class="workspace-day-tabs" role="tablist" aria-label="Lịch trình theo ngày">@for(var i=0;i<Math.Min(days,366);i++){<button type="button" id="workspace-tab-@i" role="tab" aria-selected="@(i==0?"true":"false")" aria-controls="workspace-day-@i" tabindex="@(i==0?"0":"-1")" data-workspace-day="@i" class="@(i==0?"selected":"")"><strong>Ngày @(i+1)</strong><span>@trip.Start.AddDays(i).ToString("dd/MM")</span></button>}</div>
 @for(var i=0;i<Math.Min(days,366);i++){var day=trip.Start.Date.AddDays(i);var activities=trip.Activities.Where(x=>x.Start.Date==day).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Start).ToList();
 <div class="workspace-day-panel" id="workspace-day-@i" role="tabpanel" aria-labelledby="workspace-tab-@i" hidden="@(i!=0)"><div class="day-panel-caption"><span>@day.ToString("dd/MM/yyyy") · @activities.Count hoạt động</span><a href="/Journey/Details/@trip.Id#add-activity">+ Thêm hoạt động</a></div>
 @if(!activities.Any()){<div class="workspace-empty-day"><partial name="_TravelIcon" model='@("calendar")'/><div><strong>Chưa có hoạt động trong ngày</strong><p>Thêm địa điểm hoặc dịch vụ vào kế hoạch để bắt đầu sắp lịch.</p><a class="secondary" href="/Journey/Details/@trip.Id#add-activity">Thêm hoạt động</a></div></div>}
 @foreach(var activity in activities){<div class="workspace-activity"><div class="workspace-activity-time"><strong>@(activity.HasTime?activity.Start.ToString("HH:mm"):"Cả ngày")</strong><span>@(activity.HasTime?activity.End.ToString("HH:mm"):"Chưa có giờ")</span></div><span class="activity-type-icon @(activity.TravelServiceId.HasValue?"type-service":"")"><partial name="_TravelIcon" model='@(activity.TravelServiceId.HasValue?"bag":"pin")'/></span><div class="workspace-activity-copy"><a href="/Journey/Details/@trip.Id#day-@(i+1)">@activity.Title</a><p>@(string.IsNullOrWhiteSpace(activity.Location)?(activity.TravelServiceId.HasValue?"Dịch vụ tham khảo · yêu cầu xử lý riêng":"Hoạt động tự lên kế hoạch"):activity.Location)</p>@if(!string.IsNullOrWhiteSpace(activity.Notes)){<small>@activity.Notes</small>}</div><div class="workspace-activity-cost"><strong>@(activity.Cost.HasValue?activity.Cost.Value.ToString("N0")+" đ":"Chưa dự kiến")</strong><small>Dự kiến</small></div></div>}
 <div class="workspace-day-footer"><span>Tổng ngày @day.ToString("dd/MM")</span><strong>@activities.Sum(x=>x.Cost??0).ToString("N0") đ</strong></div></div>}
 </section>
 }else{<section class="workspace-card"><header class="workspace-card-header"><h2>Kế hoạch chuyến đi</h2></header><div class="workspace-empty-day"><partial name="_TravelIcon" model='@("calendar")'/><div><strong>Bạn chưa có kế hoạch</strong><p>Tạo chuyến đi với điểm đến, thời gian và ngân sách. Sau đó thêm các hoạt động vào từng ngày.</p><a class="button" href="/Journey#new-trip">Tạo chuyến đi đầu tiên</a></div></div></section>}
 <section class="workspace-card request-inbox"><header class="workspace-card-header"><h2>Yêu cầu dịch vụ gần đây</h2><a class="text-link" href="/Marketplace/Requests">Xem tất cả <partial name="_TravelIcon" model='@("arrow")'/></a></header>@if(!Model.Bookings.Any()){<div class="workspace-empty-day"><partial name="_TravelIcon" model='@("bag")'/><div><strong>Chưa có yêu cầu dịch vụ</strong><p>Tìm dịch vụ và gửi điều kiện mong muốn để nhà cung cấp phản hồi.</p><a class="text-link" href="/Marketplace">Tìm dịch vụ →</a></div></div>}else{<div class="table-wrap"><table class="data-table"><thead><tr><th>Dịch vụ</th><th>Ngày sử dụng</th><th>Trạng thái</th><th>Chi phí</th></tr></thead><tbody>@foreach(var booking in Model.Bookings){<tr><td><a href="/Marketplace/Request/@booking.Id">@(string.IsNullOrWhiteSpace(booking.SnapshotName)?booking.TravelService?.Name:booking.SnapshotName)</a><small>Yêu cầu #@booking.Id</small></td><td>@booking.Date.ToString("dd/MM/yyyy")</td><td><span class="badge-status @(booking.Status=="Đã xác nhận"?"status-confirmed":booking.Status=="Đề xuất khác"?"status-attention":"status-draft")">@booking.Status</span></td><td>@booking.Total.ToString("N0") đ</td></tr>}</tbody></table></div>}</section>
 </div><aside class="workbench-aside">
 @if(trip!=null){<section class="workspace-card budget-widget"><header class="workspace-card-header"><h2>Chi phí dự kiến</h2><partial name="_TravelIcon" model='@("note")'/></header><div class="budget-widget-body"><small>@trip.Name</small><strong class="workspace-total">@total.ToString("N0") <span>đ</span></strong><div class="budget-track @(total>trip.Budget?"over-budget":"")"><span style="width:@ratio.ToString("0",System.Globalization.CultureInfo.InvariantCulture)%"></span></div><dl><div><dt>Ngân sách</dt><dd>@(trip.Budget.HasValue?trip.Budget.Value.ToString("N0")+" đ":"Chưa xác định")</dd></div><div class="@(total>trip.Budget?"amount-warning":"")"><dt>@(total>trip.Budget?"Vượt ngân sách":"Còn lại")</dt><dd>@(trip.Budget.HasValue?Math.Abs(trip.Budget.Value-total).ToString("N0")+" đ":"—")</dd></div></dl><a class="secondary full-width" href="/Journey/Details/@trip.Id">Điều chỉnh kế hoạch</a><p>Chi phí từ các hoạt động trong kế hoạch, chưa phải số tiền đã thanh toán.</p></div></section>}
 <section class="workspace-card attention-widget"><header class="workspace-card-header"><h2>Cần chú ý</h2><span class="attention-count">@(Model.PendingCount+Model.UnreadCount)</span></header><a href="/Marketplace/Requests"><span class="attention-icon"><partial name="_TravelIcon" model='@("bag")'/></span><span><strong>@Model.PendingCount yêu cầu đang chờ</strong><small>Xem phản hồi và điều kiện dịch vụ</small></span><span>›</span></a><a href="/Dashboard/Notifications"><span class="attention-icon"><partial name="_TravelIcon" model='@("bell")'/></span><span><strong>@Model.UnreadCount thông báo chưa đọc</strong><small>Cập nhật từ các bên liên quan</small></span><span>›</span></a></section>
 <section class="workspace-card saved-trips-widget"><header class="workspace-card-header"><h2>Kế hoạch đã lưu</h2><a href="/Journey" aria-label="Xem tất cả kế hoạch">→</a></header>@foreach(var saved in Model.Trips){<a class="saved-trip-row" href="/Journey/Details/@saved.Id"><span class="saved-trip-initial">@(string.IsNullOrWhiteSpace(saved.Destination)?"—":saved.Destination[..1])</span><span><strong>@saved.Name</strong><small>@saved.Start.ToString("dd/MM") – @saved.End.ToString("dd/MM/yyyy")</small></span><span>›</span></a>}<a class="add-saved-trip" href="/Journey#new-trip"><partial name="_TravelIcon" model='@("plus")'/>Tạo kế hoạch mới</a></section>
 </aside></div>
</section>
