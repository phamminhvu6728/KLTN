@model DashboardVm
@using TuTuc.Services
@{ViewData["Title"]="Chuyến đi của bạn";var trip=Model.ActiveTrip;var total=trip?.Activities.Sum(x=>x.Cost??0)??0;var days=trip==null?0:Math.Max(1,(trip.End.Date-trip.Start.Date).Days+1);var today=TuTuc.Services.JourneyRules.Today;var openDay=trip!=null&&trip.Start.Date<=today&&today<=trip.End.Date?(today-trip.Start.Date).Days:0;var tripPhase=trip==null?"":trip.Start.Date>today?"CHUYẾN ĐI SẮP TỚI":trip.End.Date<today?"CHUYẾN ĐI ĐÃ KẾT THÚC":"CHUYẾN ĐI ĐANG DIỄN RA";var ratio=trip?.Budget>0?Math.Min(100,total/trip.Budget.Value*100):trip!=null&&trip.Budget.HasValue&&total>0?100:0;}
<section class="section workbench" data-testid="travel-workspace">
 <div class="workspace-heading"><div><span class="eyebrow">CHUYẾN ĐI CỦA BẠN</span><h1>Xin chào, @User.Identity?.Name</h1><p>Cùng chuẩn bị cho hành trình sắp tới của bạn.</p></div><a class="button" href="/Journey#new-trip"><partial name="_TravelIcon" model='@("plus")'/>Tạo chuyến đi mới</a></div>
 @if(trip!=null){
 <article class="member-trip-feature">
  <div class="member-trip-copy"><span class="eyebrow">@tripPhase</span><h2>@trip.Name</h2><p><partial name="_TravelIcon" model='@("pin")'/>@trip.Destination <span>·</span> @trip.Start.ToString("dd/MM") – @trip.End.ToString("dd/MM/yyyy")</p><div class="member-trip-facts"><span><strong>@days</strong> ngày khám phá</span><span><strong>@trip.Activities.Count</strong> hoạt động</span><span class="badge-status @(trip.Status=="Đã chấp nhận"?"status-confirmed":"status-draft")">@trip.Status</span></div><a class="button" href="/Journey/Details/@trip.Id">Tiếp tục lên lịch trình <partial name="_TravelIcon" model='@("arrow")'/></a></div>
  <div class="member-trip-photo"><img src="@TravelPresentation.Cover(trip.Destination)" alt="Ảnh minh họa @trip.Destination"/><span>@trip.Destination</span></div>
 </article>
 }
 <div class="overview-counts">
  <a href="/Journey"><span class="overview-icon"><partial name="_TravelIcon" model='@("calendar")'/></span><span><strong>@Model.TripCount</strong><small>Kế hoạch đã lưu</small></span><span class="count-arrow">→</span></a>
  <a href="/Marketplace/Requests"><span class="overview-icon amber"><partial name="_TravelIcon" model='@("bag")'/></span><span><strong>@Model.PendingCount</strong><small>Yêu cầu đang chờ</small></span><span class="count-arrow">→</span></a>
  <a href="/Dashboard/Notifications"><span class="overview-icon green"><partial name="_TravelIcon" model='@("bell")'/></span><span><strong>@Model.UnreadCount</strong><small>Thông báo chưa đọc</small></span><span class="count-arrow">→</span></a>
 </div>
 <div class="workbench-columns"><div class="workbench-main">
 @if(trip!=null){
 <section class="workspace-card active-trip">
  <header class="workspace-card-header"><div><h2>Lịch trình của bạn</h2><p>Sắp xếp từng ngày, chủ động từng hoạt động.</p></div><a href="/Journey/Details/@trip.Id" class="text-link">Chỉnh sửa lịch trình <partial name="_TravelIcon" model='@("arrow")'/></a></header>
  <form asp-controller="Dashboard" asp-action="Index" method="get" class="workspace-trip-selector"><label>Chuyến đi đang xem<select name="tripId" onchange="this.form.requestSubmit()">@foreach(var choice in Model.TripChoices){<option value="@choice.Id" selected="@(choice.Id==trip.Id)">@choice.Name · @choice.Destination</option>}</select></label><button type="submit" class="secondary">Xem</button></form>
  <div class="workspace-day-tabs" role="tablist" aria-label="Lịch trình theo ngày">@for(var i=0;i<Math.Min(days,366);i++){<button type="button" id="workspace-tab-@i" role="tab" aria-selected="@(i==openDay?"true":"false")" aria-controls="workspace-day-@i" tabindex="@(i==openDay?"0":"-1")" data-workspace-day="@i" class="@(i==openDay?"selected":"")"><strong>Ngày @(i+1)</strong><span>@trip.Start.AddDays(i).ToString("dd/MM")</span></button>}</div>
  @for(var i=0;i<Math.Min(days,366);i++){
   var day=trip.Start.Date.AddDays(i);var activities=trip.Activities.Where(x=>x.Start.Date==day).OrderBy(x=>x.SortOrder).ThenBy(x=>x.Start).ToList();
   <div class="workspace-day-panel" id="workspace-day-@i" role="tabpanel" aria-labelledby="workspace-tab-@i" hidden="@(i!=openDay)">
    <div class="day-panel-caption"><span>@day.ToString("dd/MM/yyyy") · @activities.Count hoạt động</span><a class="text-link" href="/Journey/Details/@trip.Id#add-activity"><partial name="_TravelIcon" model='@("plus")'/>Thêm hoạt động</a></div>
    @if(!activities.Any()){<div class="workspace-empty-day"><partial name="_TravelIcon" model='@("calendar")'/><div><strong>Ngày này chưa có hoạt động</strong><p>Bạn có thể thêm một nơi muốn ghé hoặc một trải nghiệm muốn thử.</p><a class="secondary" href="/Journey/Details/@trip.Id#add-activity">Thêm hoạt động đầu tiên</a></div></div>}
    @foreach(var activity in activities){<div class="workspace-activity"><div class="workspace-activity-time"><strong>@(activity.HasTime?activity.Start.ToString("HH:mm"):"Cả ngày")</strong><span>@(activity.HasTime?activity.End.ToString("HH:mm"):"Chưa có giờ")</span></div><span class="activity-type-icon @(activity.TravelServiceId.HasValue?"type-service":"")"><partial name="_TravelIcon" model='@(activity.TravelServiceId.HasValue?"bag":"pin")'/></span><div class="workspace-activity-copy"><a href="/Journey/Details/@trip.Id#day-@(i+1)">@activity.Title</a><p>@(string.IsNullOrWhiteSpace(activity.Location)?(activity.TravelServiceId.HasValue?"Dịch vụ tham khảo · gửi yêu cầu riêng":"Hoạt động tự lên kế hoạch"):activity.Location)</p>@if(!string.IsNullOrWhiteSpace(activity.Notes)){<small>@activity.Notes</small>}</div><div class="workspace-activity-cost"><strong>@(activity.Cost.HasValue?activity.Cost.Value.ToString("N0")+" đ":"Chưa dự kiến")</strong><small>Chi phí dự kiến</small></div></div>}
    <div class="workspace-day-footer"><span>Tổng chi phí ngày @day.ToString("dd/MM")</span><strong>@activities.Sum(x=>x.Cost??0).ToString("N0") đ</strong></div>
   </div>
  }
 </section>
 }else{<section class="workspace-card"><header class="workspace-card-header"><h2>Kế hoạch chuyến đi</h2></header><div class="workspace-empty-day"><partial name="_TravelIcon" model='@("calendar")'/><div><strong>Bắt đầu chuyến đi đầu tiên</strong><p>Chọn điểm đến, thời gian và ngân sách. Bạn có thể hoàn thiện lịch trình sau.</p><a class="button" href="/Journey#new-trip">Tạo kế hoạch</a></div></div></section>}
 <section class="workspace-card request-inbox"><header class="workspace-card-header"><h2>Yêu cầu dịch vụ gần đây</h2><a class="text-link" href="/Marketplace/Requests">Xem tất cả →</a></header>@if(!Model.Bookings.Any()){<div class="workspace-empty-day"><partial name="_TravelIcon" model='@("bag")'/><div><strong>Chưa có yêu cầu dịch vụ</strong><p>Tìm dịch vụ và gửi điều kiện mong muốn cho nhà cung cấp.</p><a class="text-link" href="/Marketplace">Tìm dịch vụ →</a></div></div>}else{<div class="table-wrap"><table class="data-table"><thead><tr><th>Dịch vụ</th><th>Ngày sử dụng</th><th>Trạng thái</th><th>Chi phí</th></tr></thead><tbody>@foreach(var booking in Model.Bookings){<tr><td><a href="/Marketplace/Request/@booking.Id">@(string.IsNullOrWhiteSpace(booking.SnapshotName)?booking.TravelService?.Name:booking.SnapshotName)</a><small>Yêu cầu #@booking.Id</small></td><td>@booking.Date.ToString("dd/MM/yyyy")</td><td><span class="badge-status @(booking.Status=="Đã xác nhận"?"status-confirmed":booking.Status=="Đề xuất khác"?"status-attention":"status-draft")">@booking.Status</span></td><td>@booking.Total.ToString("N0") đ</td></tr>}</tbody></table></div>}</section>
 </div><aside class="workbench-aside">
 @if(trip!=null){<section class="workspace-card budget-widget"><header class="workspace-card-header"><h2>Ngân sách chuyến đi</h2><partial name="_TravelIcon" model='@("note")'/></header><div class="budget-widget-body"><small>Chi phí các hoạt động dự kiến</small><strong class="workspace-total">@total.ToString("N0") <span>đ</span></strong><div class="budget-track @(total>trip.Budget?"over-budget":"")"><span style="width:@ratio.ToString("0",System.Globalization.CultureInfo.InvariantCulture)%"></span></div><dl><div><dt>Ngân sách</dt><dd>@(trip.Budget.HasValue?trip.Budget.Value.ToString("N0")+" đ":"Chưa xác định")</dd></div><div class="@(total>trip.Budget?"amount-warning":"")"><dt>@(total>trip.Budget?"Vượt ngân sách":"Còn lại")</dt><dd>@(trip.Budget.HasValue?Math.Abs(trip.Budget.Value-total).ToString("N0")+" đ":"—")</dd></div></dl><a class="secondary full-width" href="/Journey/Details/@trip.Id">Điều chỉnh kế hoạch</a><p>Đây là chi phí dự kiến, chưa phải khoản đã thanh toán.</p></div></section>}
 <section class="workspace-card explore-widget"><header class="workspace-card-header"><h2>Chuẩn bị cho chuyến đi</h2></header><a href="/Home/Search"><partial name="_TravelIcon" model='@("search")'/><span><strong>Tìm nơi muốn ghé</strong><small>Tra cứu điểm đến và thông tin</small></span><span>→</span></a><a href="/Marketplace"><partial name="_TravelIcon" model='@("bag")'/><span><strong>Tìm dịch vụ phù hợp</strong><small>Lưu trú, di chuyển, trải nghiệm</small></span><span>→</span></a><a href="/Community"><partial name="_TravelIcon" model='@("people")'/><span><strong>Tìm bạn đồng hành</strong><small>Kết nối người cùng điểm đến</small></span><span>→</span></a></section>
 <section class="workspace-card saved-trips-widget"><header class="workspace-card-header"><h2>Kế hoạch đã lưu</h2><a class="text-link" href="/Journey">Tất cả →</a></header>@foreach(var saved in Model.Trips){<a class="saved-trip-row" href="/Journey/Details/@saved.Id"><span class="saved-trip-initial"><partial name="_TravelIcon" model='@("map")'/></span><span><strong>@saved.Name</strong><small>@saved.Start.ToString("dd/MM") – @saved.End.ToString("dd/MM/yyyy")</small></span><span>›</span></a>}</section>
 </aside></div>
</section>
