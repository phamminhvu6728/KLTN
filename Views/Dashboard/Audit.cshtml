@model List<AuditEntry>
@{ViewData["Title"]="Nhật ký hệ thống";}
<section class="section"><span class="eyebrow">QUẢN TRỊ HỆ THỐNG</span><h1>Nhật ký thao tác</h1><p class="muted">200 thao tác gần nhất.</p><div class="table-wrap"><table class="data-table"><thead><tr><th>Thời gian (UTC)</th><th>Tài khoản</th><th>Thao tác</th><th>Đối tượng</th><th>Mã</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td><td>#@a.ActorId</td><td>@a.Action</td><td>@a.Entity</td><td>#@a.EntityId</td></tr>}</tbody></table></div></section>
