@model List<UserNotification>
@{ViewData["Title"]="Thông báo";}
<section class="section"><div class="page-heading"><div><span class="eyebrow">CẬP NHẬT HÀNH TRÌNH</span><h1>Thông báo của bạn</h1></div><form asp-action="ReadAll" method="post"><button class="secondary">Đánh dấu tất cả đã đọc</button></form></div>@if(!Model.Any()){<div class="empty">Bạn chưa có thông báo.</div>}@foreach(var n in Model){<form asp-action="Read" method="post" class="notification-row"><input type="hidden" name="id" value="@n.Id"/><span class="notification-dot @(n.IsRead?"read":"")"></span><div><strong>@TuTuc.Services.ThongBaoLoai.Nhan(n)</strong><p>@n.Description</p><small>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(n.CreatedAt,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time")).ToString("dd/MM/yyyy HH:mm")</small></div><button class="secondary">Mở ↗</button></form>}</section>
