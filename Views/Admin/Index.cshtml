@model AdminDashboardVm
@{ViewData["Title"]="Xét duyệt dịch vụ";}
<section class="section"><div class="page-heading"><div><span class="eyebrow">KHÔNG GIAN QUẢN TRỊ</span><h1>Xét duyệt nội dung dịch vụ</h1><p class="muted">Quyết định đúng phiên bản và lưu đầy đủ người duyệt, thời điểm, lý do.</p></div><div><a class="secondary" href="/Verification">Xác minh nhà cung cấp ↗</a><a class="secondary" href="/Governance">Quyền hoạt động ↗</a></div></div><div class="stat-grid"><div class="stat-card"><span>Tài khoản</span><strong>@Model.Accounts.Count</strong></div><div class="stat-card"><span>Nhà cung cấp</span><strong>@Model.Accounts.Count(x=>x.Role=="Provider")</strong></div><div class="stat-card"><span>Chờ xét duyệt</span><strong>@Model.Revisions.Count(x=>x.Status=="Chờ duyệt")</strong></div><div class="stat-card"><span>Yêu cầu dịch vụ</span><strong>@Model.BookingCount</strong></div></div>
@if(!Model.Revisions.Any(x=>x.Status=="Chờ duyệt")){<div class="empty">Hiện không có nội dung chờ duyệt.</div>}
@foreach(var r in Model.Revisions.Where(x=>x.Status=="Chờ duyệt")){var s=r.TravelService!;var provider=Model.Accounts.FirstOrDefault(x=>x.Id==s.OwnerId);<article class="panel admin-review-card"><span class="badge-status">Phiên bản @r.RevisionNumber · #@r.Id · @r.Status</span><h2>@r.Name</h2><p class="muted">@provider?.Name · @provider?.VerificationStatus · @provider?.ProviderStatus · Gửi @r.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><div class="market-compare"><div><h3>Đang công bố</h3>@if(s.ApprovalStatus=="Đã duyệt"){<p>@s.Name · @s.Price.ToString("N0") ₫ · @s.Location</p><p>@s.Description</p><p>@s.ServingHours</p><p>@s.Conditions</p><p>@s.ClosureStart?.ToString("dd/MM/yyyy") – @s.ClosureEnd?.ToString("dd/MM/yyyy") · @s.ClosureReason · @s.ClosureScope</p>}else{<p>Chưa có nội dung được công bố.</p>}</div><div><h3>Nội dung đề nghị</h3><p>@r.Name · @r.Price.ToString("N0") ₫ · @r.Location · @r.Category</p><p style="white-space:pre-line">@r.Description</p><p>@r.ServingHours</p><p>@r.Conditions</p><p>@r.ClosureStart?.ToString("dd/MM/yyyy") – @r.ClosureEnd?.ToString("dd/MM/yyyy") · @r.ClosureReason · @r.ClosureScope</p></div></div><form asp-action="Review" method="post"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="version" value="@Convert.ToBase64String(r.Version)"/><label>Nhận xét / lý do từ chối / nội dung cần sửa<textarea name="note" maxlength="500"></textarea></label><button class="button" name="decision" value="Đã duyệt">Duyệt và công bố đúng bản</button><button class="secondary" name="decision" value="Cần sửa">Yêu cầu sửa</button><button class="secondary" name="decision" value="Từ chối">Từ chối</button></form></article>}
<h2 style="margin-top:40px">Lịch sử xét duyệt</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Phiên bản</th><th>Nội dung</th><th>Quyết định</th><th>Người / thời điểm</th><th>Lý do</th></tr></thead><tbody>@foreach(var r in Model.Revisions.Where(x=>x.Status!="Chờ duyệt").OrderByDescending(x=>x.ReviewedAt).Take(30)){<tr><td>@r.RevisionNumber · #@r.Id</td><td>@r.Name</td><td>@r.Status</td><td>@Model.Accounts.FirstOrDefault(x=>x.Id==r.ReviewedById)?.Name<br/>@r.ReviewedAt?.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td>@r.ReviewNote</td></tr>}</tbody></table></div></section>
